// Adaptive RSI Pro v7.7 Strategy Report - confirmed execution, independent exits and net closed-trade results
// MIT License - https://github.com/aaajiao/Adaptive-RSI-Pro
//
// 信号图例 / Signal Legend:
// ─────────────────────────────────────────
// 买入 BUY (底部):  🌟 MTF共振 | 💎 背离+极端 | 🔥 极端超卖 | ⬆️ 普通超卖 | ↗️ 看涨背离
// 卖出 SELL (顶部): 🌟 MTF共振 | 💎 背离+极端 | ❄️ 极端超买 | ⬇️ 普通超买 | ↘️ 看跌背离
// 状态 STATUS:      🟢 超卖 | 🟡 轻度超卖 | ⚪ 中性 | 🟠 轻度超买 | 🔴 超买
// ─────────────────────────────────────────

//@version=6
strategy("Adaptive RSI Pro Strategy Report", shorttitle="ARSI Pro STRAT", overlay=false, precision=2, max_lines_count=100, max_labels_count=100, max_bars_back=4500, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, calc_on_every_tick=false, calc_on_order_fills=false, process_orders_on_close=false)

SCRIPT_VERSION = "7.7"
// This is a budget of LOWER-TIMEFRAME bars, not chart bars.
// 小周期K线预算；主图覆盖随周期比例与数据缺口变化。
MAX_REQUEST_BARS = 100000

// ────────────────────────────────────────
// INPUTS
// ────────────────────────────────────────

grp_rsi = "═══ RSI Settings / RSI设置 ═══"
rsi_length = input.int(14, "RSI Length / RSI周期", minval=2, group=grp_rsi)
rsi_source = input.source(close, "RSI Source / 数据源", group=grp_rsi)

grp_adaptive = "═══ Adaptive Settings / 自适应设置 ═══"
lookback_mode = input.string("Auto", "Lookback Mode / 回看模式", options=["Auto", "Custom"], group=grp_adaptive, tooltip="Auto: 根据时间框架和RSI波动率自动计算\nCustom: 使用自定义值")
lookback_custom = input.int(252, "Custom Lookback / 自定义回看", minval=50, maxval=2000, group=grp_adaptive, tooltip="仅在 Custom 模式下使用。建议：日线252，4小时500，1小时750")
lookback_precision = input.string("Normal", "Precision / 精度", options=["High", "Normal", "Low"], group=grp_adaptive, tooltip="High(高精度): 需要更多数据，更准确\nNormal(平衡): 推荐设置\nLow(快适应): 更少数据，更快响应")
vol_history_mode = input.string("1 Year", "History Depth / 历史深度", options=["6 Months", "1 Year", "2 Years"], group=grp_adaptive, tooltip="波动率参考的历史时间长度\n自动根据时间框架转换为K线数量\n---\nHistory window for the volatility reference\nAuto-converted to bar count by timeframe")

grp_visual = "═══ Visual Settings / 视觉设置 ═══"
visual_line_mode = input.string("Unified", "Threshold Line Mode / 阈值线模式", options=["Unified", "Z-Score", "Percentile", "Both"], group=grp_visual, tooltip="Unified(推荐): Z-Score线+百分位标注，兼顾严谨性和直观性\nZ-Score: 仅统计学阈值线(±2σ, ±1.5σ)\nPercentile: 仅百分位线(P5-P95)\nBoth: 同时显示两种")
show_fill = input.bool(true, "Show Gradient Fill / 显示渐变填充", group=grp_visual)
show_dashboard = input.bool(true, "Show Dashboard / 显示仪表盘", group=grp_visual)
dashboard_mode = input.string("Full", "Dashboard Mode / 面板模式", options=["Mobile", "Full"], group=grp_visual, tooltip="Mobile: 极简模式(3行)，适合手机\nFull: 完整信息")
dashboard_size = input.string("Normal", "Dashboard Size / 面板大小", options=["Tiny", "Small", "Normal", "Large"], group=grp_visual)
dashboard_transparency = input.int(30, "Dashboard Transparency / 面板透明度", minval=0, maxval=100, step=10, group=grp_visual)
color_bull = input.color(color.new(#00E676, 60), "Bullish Color / 牛市颜色", group=grp_visual)
color_bear = input.color(color.new(#FF5252, 60), "Bearish Color / 熊市颜色", group=grp_visual)
color_rsi = input.color(#FFEB3B, "RSI Line Color / RSI线颜色", group=grp_visual)

grp_alerts = "═══ Alert Settings / 警报设置 ═══"
normal_signal_mode = input.string("Smart", "Normal Signal Mode / 普通信号模式", options=["Off", "On", "Smart"], group=grp_alerts, tooltip="Off: 关闭普通信号\nOn: 总是显示，使用手动阈值\nSmart: 自动判断显示+自动阈值")
normal_threshold_manual = input.float(1.5, "Manual Threshold / 手动阈值 (On模式)", minval=1.0, maxval=2.0, step=0.1, group=grp_alerts, tooltip="仅On模式使用\n1.5σ ≈ P6.7/P93.3\n1.28σ ≈ P10/P90\n---\nUsed only in On mode\n1.5σ ≈ P6.7/P93.3\n1.28σ ≈ P10/P90")
enable_signal_cooldown = input.bool(true, "Enable Signal Cooldown / 启用信号冷却", group=grp_alerts, tooltip="防止同一区域重复信号污染统计数据\n---\nPrevents repeated signals in the same zone from polluting the statistics")
cooldown_mode = input.string("Smart", "Cooldown Mode / 冷却模式", options=["Smart", "Fixed"], group=grp_alerts, tooltip="Smart: 根据市场波动率自动调整冷却期\nFixed: 使用固定冷却期")
cooldown_bars_fixed = input.int(5, "Fixed Cooldown (Bars) / 固定冷却期", minval=1, maxval=20, group=grp_alerts, tooltip="Fixed模式下的冷却时间（K线数）")
enable_smart_alert = input.bool(true, "🎯 Smart Alert / 智能警报", group=grp_alerts, tooltip="聚合同方向信号；同一根K线每次等级升级最多提醒一次\n当前同时出现买卖候选时不发操作警报\n---\nAggregates same-direction signals; at most one alert per increasing level within a bar\nNo actionable alert when both directions are currently eligible")
alert_on_close = input.bool(true, "Alert on Bar Close / 仅收盘确认警报", group=grp_alerts, tooltip="开启（默认）: 仅在K线收盘确认后触发，避免盘中候选消失后仍留下警报\n关闭: 盘中触发并允许同根等级升级；已经发出的警报不能撤回\n策略报告默认仅收盘运行，关闭本项不会让策略自动按 tick 运行\n---\nOn (default): send only on confirmed bars\nOff: allow intrabar alerts and same-bar level upgrades; sent alerts cannot be retracted\nThe strategy harness still executes at bar close by default; this input does not enable tick calculation")
alert_format = input.string("Text", "Alert Format / 警报格式", options=["Text", "JSON"], group=grp_alerts, tooltip="Text（默认）: 人类可读提醒\nJSON: 包含稳定事件ID、时间、证据来源及门槛、路径判定和价格的决策快照，供后续与实际成交记录核对；它不是成交确认\n升级后须重新创建 TradingView 警报以采用新脚本和输入\n---\nText (default): human-readable alert\nJSON: decision snapshot with a stable event ID, timestamps, evidence source/thresholds, path results and prices for reconciliation with actual fills; not a fill confirmation\nRecreate TradingView alerts after upgrading to adopt the new script and inputs")
include_risk_in_alerts = input.bool(false, "Include Risk Hints in Alerts / 警报含风险提示", group=grp_alerts, tooltip="在警报消息中包含ATR止损/止盈建议\n默认关闭，避免消息过长")
alert_rr_ratio = input.float(2.0, "Risk-Reward Ratio / 风险回报比", minval=1.5, maxval=3.0, step=0.5, group=grp_alerts, tooltip="止盈/止损比例\n2.0 = 1:2 风险回报比\n---\nTake-profit / stop-loss ratio\n2.0 = 1:2 risk-reward")

grp_protection = "═══ Trend Protection / 趋势保护 ═══"
enable_trend_protection = input.bool(true, "Enable Trend Protection / 启用趋势保护", group=grp_protection, tooltip="使用周线趋势过滤极端风险：避免在周线极端下跌中抄底\n---\nFilters extreme risk with the weekly trend\nAvoids bottom-fishing during extreme weekly downtrends")
protection_level = input.string("Moderate", "Protection Level / 保护级别", options=["Aggressive", "Moderate", "Loose"], group=grp_protection, tooltip="Aggressive: 周线必须上升趋势\nModerate(推荐): 排除周线极端下跌\nLoose: 仅排除周线RSI<20的极端情况")
enable_percentile_confirm = input.bool(false, "🎯 Percentile Confirm / 百分位确认", group=grp_protection, tooltip="极端信号需同时满足 Z-Score(-2σ) 和 Percentile(P5/P95)\n增加一项入选条件；是否改善交易胜率须按相同执行规则验证\n---\nExtreme signals require both Z-Score AND Percentile\nAdds an eligibility condition; evaluate its effect on trade win rate under identical execution rules")

grp_volume = "═══ Volume Confirmation / 成交量确认 ═══"
enable_volume_scoring = input.bool(true, "Enable Volume Scoring / 启用成交量评分", group=grp_volume, tooltip="成交量作为信号质量评分项，不强制过滤\n---\nVolume contributes to signal quality scoring\nNo hard filtering")
volume_surge_mult = input.float(1.5, "Volume Surge Multiplier / 放量倍数", minval=1.0, maxval=3.0, step=0.1, group=grp_volume, tooltip="高于均量X倍视为放量\n---\nVolume above X times the average counts as a surge")

grp_mtf = "═══ Multi-Timeframe / 多时间框架 ═══"
enable_mtf = input.bool(true, "Enable MTF RSI / 启用多时间框架", group=grp_mtf)
mtf_mode = input.string("Auto", "MTF Mode / 模式", options=["Auto", "Manual"], group=grp_mtf, tooltip="Auto: 根据分形逻辑自动选择更小周期 (向下分形)\nManual: 使用下方手动设置")
mtf_tf1_input = input.timeframe("60", "Manual TF1 / 手动周期1", group=grp_mtf)
mtf_tf2_input = input.timeframe("240", "Manual TF2 / 手动周期2", group=grp_mtf)
mtf_tf3_input = input.timeframe("D", "Manual TF3 / 手动周期3", group=grp_mtf)

grp_stats = "═══ Signal Statistics / 信号统计 ═══"
enable_stats = input.bool(true, "Enable Statistics / 启用统计", group=grp_stats)
stats_mode = input.string("Ranking", "Stats Mode / 统计模式", options=["Signal Type", "Grade", "Ranking"], group=grp_stats, tooltip="Signal Type: 按信号类型统计\nGrade: 按当下形态评分统计（不是历史优势结论）\nRanking: 信号类型 × 形态评分排行榜\n---\nSignal Type: group by signal type\nGrade: group by current setup score, not historical edge\nRanking: signal type × setup score leaderboard")
stats_forward_bars = input.int(20, "Forward Bars / 前瞻K线数", minval=5, maxval=100, group=grp_stats, tooltip="信号收盘到多少根K线后的收盘计算方向收益；正收益记为成功\n这是固定窗口方向结果，不是含成交价、退出规则和费用的已平仓交易胜率\n---\nMeasures directional return from the signal close to the close this many bars later; positive return counts as success\nThis fixed-horizon outcome is not the win rate of closed trades with actual fills, exits and costs")
stats_half_life_bars = input.int(1500, "Stats Half-Life Bars / 统计半衰期K线数", minval=0, maxval=20000, step=100, group=grp_stats, tooltip="样本权重按K线间隔指数衰减的半衰期\n1500根K线 ≈ 日线6年 / 4小时图9个月：日线上覆盖完整市场周期，同时淡出旧市场环境的样本\n0 = 关闭衰减（等权累计，旧版行为）\nAdaptive 按动态终身样本目标判断证据量，并另要求有效样本数≥5，避免用过时证据发布结论\n---\nHalf-life in bars for exponential decay of sample weights\n1500 bars ≈ 6 years on 1D / 9 months on 4H: covers a full market cycle on daily charts while fading samples from old regimes\n0 = decay off (equal-weight accumulation, legacy behavior)\nAdaptive uses a dynamic lifetime evidence target and additionally requires effective n >= 5 so stale evidence cannot issue a verdict")
stats_independent_samples = input.bool(true, "Independent Samples / 独立采样", group=grp_stats, tooltip="每个统计桶记录一个样本后，至少间隔前瞻K线数才记录下一个\n避免相邻信号的前瞻收益区间重叠而虚增样本数\n关闭 = 旧版重叠采样行为\n---\nEach bucket waits at least Forward Bars between recorded samples\nPrevents overlapping forward-return windows from inflating sample counts\nOff = legacy overlapping behavior")
enable_stats_filter = input.bool(true, "Enable Stats Filter / 启用统计过滤", group=grp_stats, tooltip="按历史统计门槛过滤信号\n综合样本成熟度、调整胜率及可选收益优势路径\n---\nFilters signals against configured historical-statistics thresholds\nUses sample maturity, adjusted win rate and the optional payoff-edge path")
stats_min_samples = input.int(20, "Evidence Reference / 证据参考值", minval=5, maxval=50, group=grp_stats, tooltip="Adaptive：这是动态样本目标的参考值。默认20会按同方向、同层级四个桶的实际样本分布生成约8–16的桶目标；结果好坏不会改变目标。关闭 Independent Samples 时，为防重叠样本虚增，目标保护性回到本参考值（默认20）\nFixed (Legacy)：本值就是固定终身样本门槛（默认20）\n本值不是统计验证或未来表现保证\n---\nAdaptive: reference for the dynamic sample target. The default 20 produces bucket targets of about 8–16 from the actual same-direction, same-scope four-bucket sample mix; outcome quality never changes the target. With Independent Samples off, an overlap guard restores the target to this reference (20 by default)\nFixed (Legacy): this value is the fixed lifetime-sample threshold (default 20)\nThis is not statistical validation or a guarantee of future performance")
stats_sample_policy = input.string("Adaptive", "Sample Policy / 样本策略", options=["Adaptive", "Fixed (Legacy)"], group=grp_stats, tooltip="Adaptive（默认）：每个桶按同方向、同层级四个 peer 桶的终身样本占比计算自己的动态目标（参考值20时约8–16），并要求有效样本数≥5。Ranking 精确桶未就绪时回退到已就绪的同方向 Signal Type 父桶；父桶使用自己的真实目标。目标只看样本结构，不看 WR/Avg\nFixed (Legacy)：始终使用 Stats Mode 指定的桶，以 Evidence Reference 作为固定终身门槛，不检查有效样本新鲜度，完全恢复旧版行为\n---\nAdaptive (default): each bucket gets a dynamic target from its lifetime-sample share among the four same-direction, same-scope peers (about 8–16 for reference 20) and also requires effective n >= 5. An unready exact Ranking bucket falls back to a ready same-direction Signal Type parent, using the parent's own target. Targets use sample structure only, never WR/Avg\nFixed (Legacy): always use the Stats Mode bucket, use Evidence Reference as the fixed lifetime threshold, and ignore effective-sample freshness, restoring previous behavior")
stats_unproven_mode = input.string("Block (Legacy)", "Unproven Buckets / 样本不足的桶", options=["Pass", "Block (Legacy)"], group=grp_stats, tooltip="证据未经判定：终身样本数不足目标，或 Adaptive 下有效样本数<5且没有可用父桶\nBlock (Legacy): 默认拦截，等待可判定证据；保留 Legacy 选项名以兼容已有设置\nPass: 允许无结论信号，包含已陈旧的桶（v7.6 默认行为）\n⏳ 表示无质量结论，✗ 表示已有结论但未达到门槛；拦截更多不等于已证明胜率更高\n---\nUnproven means lifetime n is below target, or Adaptive effective n < 5 with no ready parent\nBlock (Legacy): block by default until evidence is ready; the option name is retained for compatibility\nPass: allow unproven signals, including stale buckets (the v7.6 default)\nAn hourglass means no quality verdict; a cross means a ready verdict missed the rule. More filtering does not establish higher win rate")
stats_min_winrate = input.float(55.0, "Min Adjusted WinRate / 最小调整胜率", minval=50.0, maxval=70.0, step=1.0, group=grp_stats, tooltip="固定前瞻窗口的收缩调整胜率门槛；55 是保留的配置参考值，未经实盘表现验证\nEdge vs Baseline 下：(本值 - 50) 是相对方向基准所需的最小优势（百分点）\n收缩权重 min(1, effective_n/20) 是启发式权重，不是统计置信度、后验概率或真实交易胜率\n---\nThreshold for shrunk fixed-horizon win rate; 55 is a retained configuration reference, not validated live performance\nIn Edge vs Baseline mode, (value - 50) is the required edge over the direction baseline in percentage points\nThe shrinkage weight min(1, effective_n/20) is a heuristic weight, not statistical confidence, posterior probability or realized trade win rate")
stats_gate_mode = input.string("Edge vs Baseline", "Gate Mode / 门槛模式", options=["Edge vs Baseline", "Absolute (Legacy)"], group=grp_stats, tooltip="Edge vs Baseline: 胜率门槛相对方向的无条件固定窗口基准，估计值按启发式权重向基准收缩\n有效门槛保留25%~90%钳制；极端基准触及钳制时，通过不一定代表正优势\nAbsolute (Legacy): 固定绝对门槛，向50%收缩\n两者都不直接度量已平仓交易胜率\n---\nEdge vs Baseline: compares against the direction's unconditional fixed-horizon baseline, with heuristic shrinkage toward that baseline\nThe requirement retains its 25-90% clamp; at extreme clamped baselines, a pass need not imply positive edge\nAbsolute (Legacy): fixed absolute threshold with shrinkage toward 50%\nNeither directly measures the win rate of closed trades")
stats_payoff_mode = input.string("Off", "Payoff Gate / 收益优势门槛", options=["Off", "Either Edge", "Both Edges"], group=grp_stats, tooltip="仅在 Edge vs Baseline 模式生效\nOff（默认）: 必须通过胜率路径；收益优势只作参考\nEither Edge: 胜率或收益优势任一通过即可，保留用于对照实验（v7.6 默认）\nBoth Edges: 两条路径都必须通过\n先达到证据目标，再判断质量；不足时由 Unproven Buckets 决定\n默认值使胜率路径成为必要条件，不代表已验证实际交易胜率提高\n---\nApplies only in Edge vs Baseline mode\nOff (default): the win-rate path must pass; payoff edge is descriptive\nEither Edge: either path can pass, retained for comparison (v7.6 default)\nBoth Edges: both paths must pass\nEvidence readiness is required before a quality verdict; otherwise Unproven Buckets applies\nThe default makes the win-rate path mandatory; it does not establish an improvement in realized trade win rate")
stats_min_payoff_edge = input.float(0.4, "Min Payoff Edge % / 最小收益优势", minval=0.0, maxval=10.0, step=0.1, group=grp_stats, tooltip="固定前瞻窗口收益优势路径的门槛（百分比）\n收缩后收益优势 = min(1, effective_n/20) ×（桶平均收益 - 方向基准平均收益）\n0.4 是保留的配置值，不是噪声检验或费用门槛；权重不是统计置信度\n---\nThreshold for the payoff-edge path in fixed-horizon return percent\nShrunk payoff edge = min(1, effective_n/20) × (bucket average return - direction baseline average)\n0.4 is a retained setting, not a noise test or a cost allowance; the weight is not statistical confidence")
stats_filter_mode = input.string("Alert Only", "Filter Mode / 过滤模式", options=["Alert Only", "Soft", "Hard"], group=grp_stats, tooltip="Alert Only: 仅过滤警报，图表显示所有信号\nSoft: 低质量信号降级显示\nHard: 完全隐藏低质量信号")
// @harness: inputs

grp_harness = "═══ Strategy Report / 策略回测 ═══"
harness_trade_side = input.string("Long Only", "Trade Side / 交易方向", options=["Long Only", "Short Only", "Both"], group=grp_harness, tooltip="Long Only: 仅做多，卖出信号只平多\nShort Only: 仅做空，买入信号只平空\nBoth: 双向切换，买卖信号会反手")
harness_backtest_mode = input.string("Production", "Backtest Mode / 回测模式", options=["Baseline", "Production"], group=grp_harness, tooltip="Baseline: raw v7.2 signals, no stats filter\nProduction: gate-passing production alert signals; not exact intrabar alert delivery\nBaseline: 使用 7.2 原始信号，不加统计过滤\nProduction: 使用通过正式警报 gate/过滤的信号，不精确模拟盘中 alert 投递")
harness_exit_signal_policy = input.string("Raw", "Exit Signal Policy / 退出信号策略", options=["Raw", "Filtered (Legacy)"], group=grp_harness, tooltip="Raw: opposite exit candidates bypass entry trend/data/statistics/cooldown and weekly Smart visibility; percentile confirmation and Normal Off still apply\nFiltered (Legacy): opposite signals use the selected Backtest Mode gate, as before\nATR/time/date exits always remain independent of the entry gate\nRaw：反向退出候选绕过入场趋势、数据、统计、冷却及周线Smart显示限制；仍尊重百分位确认与普通信号Off\nFiltered (Legacy)：反向信号沿用所选回测模式的过滤结果\nATR、时间和评估结束退出始终独立于入场门槛")
harness_use_risk_exits = input.bool(false, "Use ATR SL/TP Exits / 启用ATR止损止盈", group=grp_harness, tooltip="On: trades exit via the same ATR-based SL/TP prices the alerts advertise; prices are snapshotted at the signal bar's close (the entry order fills at the next bar's open)\nOff: trades exit only on opposite signals (legacy harness behavior)\n开启：按警报展示的ATR止损/止盈价格退出；价格在信号K线收盘时快照（入场单在下一根K线开盘成交）\n关闭：仅按反向信号平仓（原有回测行为）")
harness_max_holding_bars = input.int(0, "Max Holding Bars / 最大持仓K线数", minval=0, group=grp_harness, tooltip="0 = off\n>0: force-close the position after holding N bars (Time Exit)\n0 = 关闭\n大于0：持仓达到N根K线后强制平仓（时间退出）")
harness_use_date_range = input.bool(false, "Use Evaluation Dates / 启用评估日期", group=grp_harness, tooltip="Off: trade all loaded history after data warmup\nOn: earlier bars train statistics but cannot open trades; entries need a bar opening at/after Start and closing before End\nEnd requests liquidation at the first available bar close reaching End; market orders still fill at the next available open, including gaps\n关闭：数据准备好后使用全部已加载历史\n开启：开始前只积累统计；入场信号K线须在开始后开盘、结束前收盘\n首次达到结束时间的可用K线收盘时请求平仓，仍在下一可用开盘成交，含跳空")
harness_start_time = input.time(1577836800000, "Evaluation Start / 评估开始", group=grp_harness)
harness_end_time = input.time(4102444800000, "Evaluation End / 评估结束", group=grp_harness)

grp_divergence = "═══ Divergence Settings / 背离设置 ═══"
enable_divergence = input.bool(true, "Enable Divergence Detection / 启用背离检测", group=grp_divergence)
div_mode = input.string("Auto", "Divergence Mode / 背离模式", options=["Auto", "Low Vol", "Normal", "High Vol", "Crypto", "Custom"], group=grp_divergence, tooltip="Auto: 根据ATR自动判断\nLow Vol: 蓝筹/ETF\nNormal: 一般股票\nHigh Vol: 成长/小盘\nCrypto: 加密货币")
div_lookback_custom = input.int(5, "Custom Lookback / 自定义回看", minval=2, maxval=20, group=grp_divergence, tooltip="仅在 Custom 模式下使用")
div_range_custom = input.int(60, "Custom Range / 自定义范围", minval=20, maxval=200, group=grp_divergence, tooltip="仅在 Custom 模式下使用")

// 波动性检测
atr_20 = ta.atr(20)
avg_volatility = ta.sma(atr_20 / close * 100, 252)
auto_vol_type = avg_volatility > 6 ? "Crypto" : avg_volatility > 3 ? "High Vol" : avg_volatility > 1 ? "Normal" : "Low Vol"
// @harness: risk-direction

strategy_allowed_direction = harness_trade_side == "Long Only" ? strategy.direction.long :
                             harness_trade_side == "Short Only" ? strategy.direction.short :
                             strategy.direction.all
strategy.risk.allow_entry_in(strategy_allowed_direction)
bool harness_use_production = harness_backtest_mode == "Production"
bool harness_dates_valid = not harness_use_date_range or harness_start_time < harness_end_time
bool harness_training = harness_use_date_range and time < harness_start_time
bool harness_evaluation_ended = harness_use_date_range and time_close >= harness_end_time
bool harness_in_evaluation = harness_dates_valid and (not harness_use_date_range or (time >= harness_start_time and time_close < harness_end_time))

// ADX 趋势强度检测 (v6.9)
[adx_di_plus, adx_di_minus, adx_value] = ta.dmi(14, 14)
adx_is_trending = adx_value > 25
adx_trend_up = adx_di_plus > adx_di_minus
adx_trend_down = adx_di_minus > adx_di_plus

// 智能冷却期基础值
base_cooldown = avg_volatility > 6 ? 2 : avg_volatility > 3 ? 3 : avg_volatility > 1 ? 5 : 8
vol_short_term = ta.sma(atr_20 / close * 100, 20)

// 智能普通信号阈值（基于波动率）
auto_normal_threshold = avg_volatility > 6 ? 1.0 : avg_volatility > 3 ? 1.28 : avg_volatility > 1 ? 1.5 : 1.8
normal_threshold = normal_signal_mode == "On" ? normal_threshold_manual : auto_normal_threshold

// 背离模式参数
active_div_mode = div_mode == "Auto" ? auto_vol_type : div_mode
div_lookback = div_mode == "Custom" ? div_lookback_custom : active_div_mode == "Low Vol" ? 3 : active_div_mode == "Normal" ? 5 : active_div_mode == "High Vol" ? 7 : 10
div_range = div_mode == "Custom" ? div_range_custom : active_div_mode == "Low Vol" ? 40 : active_div_mode == "Normal" ? 60 : active_div_mode == "High Vol" ? 80 : 120
chart_tf_seconds = timeframe.in_seconds(timeframe.period)

// ────────────────────────────────────────
// RSI CALCULATION
// ────────────────────────────────────────

rsi = ta.rsi(rsi_source, rsi_length)

// ────────────────────────────────────────
// DYNAMIC LOOKBACK CALCULATION
// ────────────────────────────────────────

vol_short_period = rsi_length * 4
vol_history_days = vol_history_mode == "6 Months" ? 126 : vol_history_mode == "1 Year" ? 252 : 504
tf_minutes = timeframe.in_seconds(timeframe.period) / 60
// 正确计算每日对应的K线数：周线=1/5天，月线=1/21天
bars_per_day = timeframe.ismonthly ? 1.0 / 21 : timeframe.isweekly ? 1.0 / 5 : timeframe.isdaily ? 1 : math.ceil(1440 / tf_minutes)
vol_long_period = math.min(4500, int(vol_history_days * bars_per_day))

vol_short = nz(ta.stdev(rsi, vol_short_period), 10)
vol_long = nz(ta.stdev(rsi, vol_long_period), 10)
vol_base = vol_long * 0.7 + vol_short * 0.3
recent_high = vol_short > vol_long * 1.2
vol_dynamic = recent_high ? (vol_short * 0.6 + vol_long * 0.4) : vol_base

// 智能冷却期动态调整
price_vol_active = vol_short_term > avg_volatility * 1.2
rsi_vol_active = vol_short > vol_long * 1.2
market_active = price_vol_active or rsi_vol_active
smart_cooldown_bars = market_active ? math.max(base_cooldown - 1, 1) : base_cooldown
cooldown_bars = cooldown_mode == "Smart" ? smart_cooldown_bars : cooldown_bars_fixed

// 统计样本量计算: n = (Z × σ / E)²
rsi_vol_bootstrap = math.max(vol_dynamic, vol_long * 0.8)
stat_lookback = math.max(50, math.pow(1.96 * rsi_vol_bootstrap / 5, 2))
stat_error = lookback_precision == "High" ? 2.0 : lookback_precision == "Normal" ? 2.5 : 3.5
stat_required = math.pow(1.96 * rsi_vol_bootstrap / stat_error, 2)

// Smart Lookback: 基于波动率和统计需求的动态范围
// 价格波动率决定基础范围
price_based_min = avg_volatility > 6 ? 50 : avg_volatility > 3 ? 80 : avg_volatility > 1 ? 150 : 200
price_based_max = avg_volatility > 6 ? 400 : avg_volatility > 3 ? 600 : avg_volatility > 1 ? 800 : 1000
// 统计需求决定最小值下限（确保 lookback ≈ stat_required）
stat_based_min = math.max(50, int(stat_required * 0.8))
// 取价格波动和统计需求中较高值作为最终最小值
lookback_min = math.max(price_based_min, stat_based_min)
lookback_max = price_based_max

// 分布宽度反馈（使用前一个bar的spread，形成反馈环）
// 只在分布窄时增加lookback，分布宽时不减少（避免低于统计需求）
// 滞回区间：spread < 18 启用 1.3，spread > 22 释放回 1.0，18-22 之间保持原状态，避免阈值附近反复跳变
// Hysteresis: engage 1.3 below 18, release to 1.0 above 22, hold previous state in between
var float prev_spread = 30.0
var bool spread_boost_active = false
spread_boost_active := prev_spread < 18 ? true : prev_spread > 22 ? false : spread_boost_active
spread_factor = spread_boost_active ? 1.3 : 1.0

// 最终 lookback = 统计基础 × 反馈因子，保守地不低于 stat_required
auto_lookback_base = math.max(stat_required, stat_required * spread_factor)
auto_lookback = int(math.max(lookback_min, math.min(lookback_max, auto_lookback_base)))
lookback = lookback_mode == "Custom" ? math.min(1000, lookback_custom) : auto_lookback

// 健康度指标
health_sample_coverage = bar_index >= lookback * 0.8
health_stat_valid = lookback >= stat_required * 0.9
theoretical_lookback = int(math.max(100, math.min(2000, math.ceil(stat_lookback))))

// ────────────────────────────────────────
// ADAPTIVE PERCENTILE CALCULATION
// ────────────────────────────────────────

rsi_p5  = ta.percentile_nearest_rank(rsi, lookback, 5)
rsi_p10 = ta.percentile_nearest_rank(rsi, lookback, 10)
rsi_p25 = ta.percentile_nearest_rank(rsi, lookback, 25)
rsi_p50 = ta.percentile_nearest_rank(rsi, lookback, 50)
rsi_p75 = ta.percentile_nearest_rank(rsi, lookback, 75)
rsi_p90 = ta.percentile_nearest_rank(rsi, lookback, 90)
rsi_p95 = ta.percentile_nearest_rank(rsi, lookback, 95)
current_spread = rsi_p95 - rsi_p5
health_distribution_spread = current_spread >= 15
prev_spread := current_spread

// ────────────────────────────────────────
// RSI Z-SCORE CALCULATION
// ────────────────────────────────────────

rsi_mean = ta.sma(rsi, lookback)
rsi_stdev = ta.stdev(rsi, lookback)
rsi_zscore = rsi_stdev != 0 ? (rsi - rsi_mean) / rsi_stdev : 0

zscore_upper_2 = rsi_mean + rsi_stdev * 2
zscore_upper_1_5 = rsi_mean + rsi_stdev * 1.5
zscore_lower_1_5 = rsi_mean - rsi_stdev * 1.5
zscore_lower_2 = rsi_mean - rsi_stdev * 2

// ────────────────────────────────────────
// Z-SCORE ↔ PERCENTILE CONVERSION
// ────────────────────────────────────────

f_zscore_to_percentile(_zscore) =>
    _z = math.abs(_zscore)
    _pct = _z >= 3.0 ? 99.9 :
           _z >= 2.5 ? 99.4 :
           _z >= 2.0 ? 97.7 :
           _z >= 1.96 ? 97.5 :
           _z >= 1.5 ? 93.3 :
           _z >= 1.28 ? 90.0 :
           _z >= 1.0 ? 84.1 :
           _z >= 0.67 ? 75.0 :
           _z >= 0.5 ? 69.1 :
           _z >= 0.25 ? 59.9 : 50.0
    _zscore >= 0 ? _pct : 100 - _pct

// ────────────────────────────────────────
// TREND PROTECTION (Weekly-based)
// ────────────────────────────────────────

[weekly_rsi, weekly_sma20, weekly_sma50] = request.security(
    syminfo.tickerid, "W",
    [ta.rsi(close, 14)[1], ta.sma(close, 20)[1], ta.sma(close, 50)[1]],
    lookahead=barmerge.lookahead_on
)

weekly_data_ready = not na(weekly_rsi) and not na(weekly_sma20) and not na(weekly_sma50)
weekly_uptrend = weekly_sma20 > weekly_sma50
weekly_extreme_bearish = weekly_rsi < 30 and weekly_sma20 < weekly_sma50
weekly_ultra_bearish = weekly_rsi < 20

trend_allows_buy = weekly_data_ready and (protection_level == "Aggressive" ? weekly_uptrend : protection_level == "Moderate" ? not weekly_extreme_bearish : not weekly_ultra_bearish)

weekly_downtrend = weekly_sma20 < weekly_sma50
weekly_extreme_bullish = weekly_rsi > 70 and weekly_sma20 > weekly_sma50
weekly_ultra_bullish = weekly_rsi > 80

trend_allows_sell = weekly_data_ready and (protection_level == "Aggressive" ? weekly_downtrend : protection_level == "Moderate" ? not weekly_extreme_bullish : not weekly_ultra_bullish)

// 智能普通信号显示逻辑
weekly_neutral = weekly_data_ready and not weekly_extreme_bearish and not weekly_extreme_bullish
auto_show_normal = weekly_neutral
show_normal_signals = normal_signal_mode == "Off" ? false : normal_signal_mode == "On" ? true : auto_show_normal

// ────────────────────────────────────────
// VOLUME CONFIRMATION
// ────────────────────────────────────────

vol_sma20 = ta.sma(volume, 20)
volume_ratio = vol_sma20 > 0 ? volume / vol_sma20 : 1.0

volume_surge = volume_ratio >= volume_surge_mult
volume_normal = volume_ratio >= 0.8 and volume_ratio < volume_surge_mult
volume_low = volume_ratio < 0.8
volume_score = volume_surge ? 20 : volume_normal ? 10 : 0

// ────────────────────────────────────────
// MULTI-TIMEFRAME RSI
// ────────────────────────────────────────

f_get_auto_timeframes() =>
    string t1 = "60"
    string t2 = "240"
    string t3 = "D"

    if timeframe.isdaily
        t1 := "60"
        t2 := "240"
        t3 := "D"
    else if timeframe.in_seconds(timeframe.period) >= 14400
        t1 := "15"
        t2 := "60"
        t3 := "240"
    else if timeframe.in_seconds(timeframe.period) >= 3600
        t1 := "5"
        t2 := "15"
        t3 := "60"
    else if timeframe.in_seconds(timeframe.period) >= 900
        t1 := "1"
        t2 := "5"
        t3 := "15"
    else
        t1 := "1"
        t2 := "3"
        t3 := "5"

    [t1, t2, t3]

[auto_t1, auto_t2, auto_t3] = f_get_auto_timeframes()
active_tf1 = mtf_mode == "Auto" ? auto_t1 : mtf_tf1_input
active_tf2 = mtf_mode == "Auto" ? auto_t2 : mtf_tf2_input
active_tf3 = mtf_mode == "Auto" ? auto_t3 : mtf_tf3_input

f_status(_rsi, _p10, _p90) =>
    na(_rsi) or na(_p10) or na(_p90) ? int(na) : _rsi < _p10 ? 1 : _rsi > _p90 ? -1 : 0

f_mtf_status_expr(_lookback) =>
    _rsi = ta.rsi(rsi_source, rsi_length)
    _p10 = ta.percentile_nearest_rank(_rsi, _lookback, 10)
    _p90 = ta.percentile_nearest_rank(_rsi, _lookback, 90)
    f_status(_rsi, _p10, _p90)

f_array_last_status(array<int> _values) =>
    _size = array.size(_values)
    _size > 0 ? array.get(_values, _size - 1) : int(na)

f_tf_seconds(_tf) =>
    _seconds = timeframe.in_seconds(_tf)
    na(_seconds) ? chart_tf_seconds : _seconds

// 缺失数据和未预热状态保留 na，不能伪装成中性或借用当前周期。
// Preserve missing/unwarmed data as na, never neutral or a copy of the chart context.
f_mtf_status(_tf) =>
    _tf_seconds = f_tf_seconds(_tf)
    array<int> _statuses = request.security_lower_tf(
        syminfo.tickerid,
        _tf,
        f_mtf_status_expr(lookback),
        ignore_invalid_timeframe=true,
        calc_bars_count=MAX_REQUEST_BARS
    )
    _current = f_status(rsi, rsi_p10, rsi_p90)
    _htf_status = request.security(
        syminfo.tickerid,
        _tf,
        f_mtf_status_expr(lookback)[1],
        lookahead=barmerge.lookahead_on
    )
    _status = _tf_seconds < chart_tf_seconds ? f_array_last_status(_statuses) : _tf_seconds == chart_tf_seconds ? _current : _htf_status
    _available = not na(_status)
    [_status, _available]

f_tf_display(_tf) =>
    if str.contains(_tf, "D") or str.contains(_tf, "W") or str.contains(_tf, "M")
        _tf
    else
        int_tf = str.tonumber(_tf)
        if not na(int_tf)
            if int_tf < 60
                str.format("{0}m", int_tf)
            else if int_tf % 60 == 0
                str.format("{0}h", int_tf / 60)
            else
                str.format("{0}m", int_tf)
        else
            _tf

mtf_tf1_display = f_tf_display(active_tf1)
mtf_tf2_display = f_tf_display(active_tf2)
mtf_tf3_display = f_tf_display(active_tf3)

[mtf_status_tf1, mtf_avail_tf1] = f_mtf_status(active_tf1)
[mtf_status_tf2, mtf_avail_tf2] = f_mtf_status(active_tf2)
[mtf_status_tf3, mtf_avail_tf3] = f_mtf_status(active_tf3)
status_tf1 = enable_mtf ? mtf_status_tf1 : 0
status_tf2 = enable_mtf ? mtf_status_tf2 : 0
status_tf3 = enable_mtf ? mtf_status_tf3 : 0
// 就绪状态同时约束新入场、警报和信号发生时的样本资格。
// Readiness gates new entries, alerts, and sample eligibility at the signal bar.
mtf_data_ok_tf1 = not enable_mtf or mtf_avail_tf1
mtf_data_ok_tf2 = not enable_mtf or mtf_avail_tf2
mtf_data_ok_tf3 = not enable_mtf or mtf_avail_tf3
status_current = f_status(rsi, rsi_p10, rsi_p90)

// 去重必须按秒数比较：日线图上 timeframe.period 返回 "1D" 而自动 TF3 是 "D"，字符串比较会失败，导致图表自身状态被重复计权、共振条件被放宽（日线+任一低周期 即触发，而非三周期全部一致）
// Dedupe must compare seconds: on daily charts timeframe.period returns "1D" while the auto TF3 string is "D", so a string compare fails — the chart's own status gets double-weighted and resonance loosens (daily + any one lower TF instead of all three agreeing)
tf1_is_current = f_tf_seconds(active_tf1) == chart_tf_seconds
tf2_is_current = f_tf_seconds(active_tf2) == chart_tf_seconds
tf3_is_current = f_tf_seconds(active_tf3) == chart_tf_seconds

// Keep the highest-slot weight when Manual TFs repeat; each distinct context votes once.
// 手动周期重复时保留较高槽位权重，每个不同周期只计一次。
tf1_is_unique = not tf1_is_current and f_tf_seconds(active_tf1) != f_tf_seconds(active_tf2) and f_tf_seconds(active_tf1) != f_tf_seconds(active_tf3)
tf2_is_unique = not tf2_is_current and f_tf_seconds(active_tf2) != f_tf_seconds(active_tf3)
tf3_is_unique = not tf3_is_current
valid_tf_count = 1 + (tf1_is_unique ? 1 : 0) + (tf2_is_unique ? 1 : 0) + (tf3_is_unique ? 1 : 0)
mtf_context_ready = not enable_mtf or ((not tf1_is_unique or mtf_data_ok_tf1) and (not tf2_is_unique or mtf_data_ok_tf2) and (not tf3_is_unique or mtf_data_ok_tf3))
chart_data_ready = not na(rsi_zscore) and not na(rsi_p5) and not na(rsi_p10) and not na(rsi_p90) and not na(rsi_p95)
// Weekly features remain in setup scoring even when trend protection is off.
// 趋势保护关闭后，周线仍参与评分，因此也必须完成预热。
signal_data_ready = chart_data_ready and weekly_data_ready and mtf_context_ready
signal_data_reason = not chart_data_ready ? "RSI warmup" : not weekly_data_ready ? "Weekly warmup" : not mtf_context_ready ? "MTF coverage / warmup" : "Ready"
var int evidence_start_time = na
if signal_data_ready and na(evidence_start_time)
    evidence_start_time := time

// 简单计数（用于显示）
oversold_count = (status_current == 1 ? 1 : 0) + (tf1_is_unique and status_tf1 == 1 ? 1 : 0) + (tf2_is_unique and status_tf2 == 1 ? 1 : 0) + (tf3_is_unique and status_tf3 == 1 ? 1 : 0)
overbought_count = (status_current == -1 ? 1 : 0) + (tf1_is_unique and status_tf1 == -1 ? 1 : 0) + (tf2_is_unique and status_tf2 == -1 ? 1 : 0) + (tf3_is_unique and status_tf3 == -1 ? 1 : 0)

// v6.8: 加权共振 - TF3权重2, 其他权重1, 满分5
oversold_weighted = (status_current == 1 ? 1 : 0) + (tf1_is_unique and status_tf1 == 1 ? 1 : 0) + (tf2_is_unique and status_tf2 == 1 ? 1 : 0) + (tf3_is_unique and status_tf3 == 1 ? 2 : 0)
overbought_weighted = (status_current == -1 ? 1 : 0) + (tf1_is_unique and status_tf1 == -1 ? 1 : 0) + (tf2_is_unique and status_tf2 == -1 ? 1 : 0) + (tf3_is_unique and status_tf3 == -1 ? 2 : 0)

// 最大加权分数
max_weighted = 1 + (tf1_is_unique ? 1 : 0) + (tf2_is_unique ? 1 : 0) + (tf3_is_unique ? 2 : 0)

// 共振触发：加权分数 >= 4（满分5），或当周期数少时全部一致
oversold_resonance = enable_mtf and mtf_context_ready and valid_tf_count >= 2 and (oversold_weighted >= 4 or (valid_tf_count <= 3 and oversold_count == valid_tf_count))
overbought_resonance = enable_mtf and mtf_context_ready and valid_tf_count >= 2 and (overbought_weighted >= 4 or (valid_tf_count <= 3 and overbought_count == valid_tf_count))

// ────────────────────────────────────────
// SIGNAL STATISTICS
// ────────────────────────────────────────

type SignalStats
    float count = 0.0
    float total_return = 0.0
    float wins = 0.0
    int last_update_bar = 0
    int last_sample_bar = na
    int lifetime_count = 0

// 惰性指数衰减：读取/更新时按距上次更新的K线数计算 0.5^(Δbars/半衰期)。
// 比值类指标（均值、胜率）对衰减不变；有效样本数决定收缩置信度，并在 Adaptive 中防止 stale 证据发布结论。
method get_decay_factor(SignalStats this) =>
    stats_half_life_bars <= 0 ? 1.0 : math.pow(0.5, float(bar_index - this.last_update_bar) / stats_half_life_bars)

method get_count(SignalStats this) =>
    this.count * this.get_decay_factor()

// 终身样本数不衰减：样本充分性检查使用它
// 信号间隔为 s 时有效样本数的稳态上限为 1/(1-0.5^(s/半衰期))，因此终身样本目标与有效样本新鲜度必须分开判断
// Lifetime sample count never decays: sample-sufficiency checks use it
// With signal spacing s the effective count is capped at 1/(1-0.5^(s/half_life)), so lifetime evidence targets and effective-sample freshness remain separate checks
method get_lifetime_count(SignalStats this) =>
    this.lifetime_count

method update(SignalStats this, bool triggered, float ret, bool enforce_spacing) =>
    // 独立采样：距本桶上次采样不足前瞻K线数时跳过，避免前瞻收益区间重叠
    _spacing_ok = not enforce_spacing or na(this.last_sample_bar) or bar_index - this.last_sample_bar >= stats_forward_bars
    if triggered and _spacing_ok
        _decay = this.get_decay_factor()
        this.count := this.count * _decay + 1
        this.total_return := this.total_return * _decay + ret
        this.wins := this.wins * _decay + (ret > 0 ? 1.0 : 0.0)
        this.last_update_bar := bar_index
        this.last_sample_bar := bar_index
        this.lifetime_count := this.lifetime_count + 1

method get_avg(SignalStats this) =>
    this.count > 0 ? this.total_return / this.count : 0.0

method get_winrate(SignalStats this) =>
    this.count > 0 ? this.wins / this.count * 100 : 0.0

method get_adjusted_winrate_vs(SignalStats this, float prior) =>
    // 样本充分性按终身样本数判断；衰减后的有效样本数只决定置信度（有效样本越少越贴近先验）
    // Sample sufficiency uses the lifetime count; the decayed effective count only sets the confidence (fewer effective samples -> closer to the prior)
    _eff_count = this.get_count()
    if this.lifetime_count < 5
        na
    else
        confidence = math.min(1.0, _eff_count / 20.0)
        raw_rate = this.get_winrate()
        prior * (1 - confidence) + raw_rate * confidence

method get_adjusted_winrate(SignalStats this) =>
    this.get_adjusted_winrate_vs(50.0)

method get_shrunk_payoff_edge_vs(SignalStats this, float baseline_avg) =>
    // 收益优势与胜率路径采用同一反夸大收缩：原始优势（桶均值−基准均值）× 置信度，小样本/旧样本桶收敛到0优势
    // Same anti-overclaim shrinkage as the win-rate path: raw edge (bucket avg − baseline avg) × confidence, so small/stale buckets converge to zero edge
    _eff_count = this.get_count()
    if this.lifetime_count < 5
        na
    else
        confidence = math.min(1.0, _eff_count / 20.0)
        confidence * (this.get_avg() - baseline_avg)

STATS_SIGNAL_MTF = 0
STATS_SIGNAL_DIV = 1
STATS_SIGNAL_EXT = 2
STATS_SIGNAL_NORM = 3
STATS_SIGNAL_COUNT = 4

STATS_GRADE_COUNT = 4
STATS_EVIDENCE_PEER_COUNT = 4
STATS_DIR_BUY = 0
STATS_DIR_SELL = 1
STATS_DIR_COUNT = 2

STATS_SIGNAL_BUCKETS = STATS_SIGNAL_COUNT * STATS_DIR_COUNT
STATS_GRADE_BUCKETS = STATS_GRADE_COUNT * STATS_DIR_COUNT
STATS_RANKING_BUCKETS = STATS_SIGNAL_COUNT * STATS_GRADE_COUNT * STATS_DIR_COUNT
STATS_RANKING_BUCKETS_PER_SIGNAL = STATS_GRADE_COUNT * STATS_DIR_COUNT

var array<SignalStats> signal_type_stats = array.new<SignalStats>(0)
var array<SignalStats> grade_stats = array.new<SignalStats>(0)
var array<SignalStats> ranking_stats = array.new<SignalStats>(0)
var array<SignalStats> baseline_stats = array.new<SignalStats>(0)

if array.size(signal_type_stats) == 0
    for i = 0 to STATS_SIGNAL_BUCKETS - 1
        array.push(signal_type_stats, SignalStats.new())
    for i = 0 to STATS_GRADE_BUCKETS - 1
        array.push(grade_stats, SignalStats.new())
    for i = 0 to STATS_RANKING_BUCKETS - 1
        array.push(ranking_stats, SignalStats.new())
    for i = 0 to STATS_DIR_COUNT - 1
        array.push(baseline_stats, SignalStats.new())

f_dir_bucket_index(_is_buy) =>
    _is_buy ? STATS_DIR_BUY : STATS_DIR_SELL

f_signal_kind_index(_is_mtf, _is_div, _is_ext) =>
    _is_mtf ? STATS_SIGNAL_MTF : _is_div ? STATS_SIGNAL_DIV : _is_ext ? STATS_SIGNAL_EXT : STATS_SIGNAL_NORM

f_grade_bucket_index_value(_grade) =>
    _grade == "A" ? 0 : _grade == "B" ? 1 : _grade == "C" ? 2 : 3

f_grade_value(_grade_idx) =>
    _grade_idx == 0 ? "A" : _grade_idx == 1 ? "B" : _grade_idx == 2 ? "C" : "D"

f_signal_type_bucket_index(_is_buy, _signal_idx) =>
    _signal_idx * STATS_DIR_COUNT + f_dir_bucket_index(_is_buy)

f_grade_bucket_index(_is_buy, _grade) =>
    f_grade_bucket_index_value(_grade) * STATS_DIR_COUNT + f_dir_bucket_index(_is_buy)

f_ranking_bucket_index(_is_buy, _signal_idx, _grade) =>
    (_signal_idx * STATS_GRADE_COUNT + f_grade_bucket_index_value(_grade)) * STATS_DIR_COUNT + f_dir_bucket_index(_is_buy)

f_update_stats_bucket(array<SignalStats> _stats, int _idx, bool _triggered, float _ret) =>
    _bucket = array.get(_stats, _idx)
    _bucket.update(_triggered, _ret, stats_independent_samples)

// 方向基准胜率：基准桶每根可计算K线都记录无条件前瞻收益，估计该方向的基础胜率
f_stats_baseline_rate(_is_buy) =>
    _baseline = array.get(baseline_stats, f_dir_bucket_index(_is_buy))
    _baseline.count > 0 ? _baseline.get_winrate() : 50.0

// 调整胜率的先验：Edge vs Baseline 模式收缩到方向基准，旧版模式收缩到50%
f_stats_display_prior(_is_buy) =>
    stats_gate_mode == "Edge vs Baseline" ? f_stats_baseline_rate(_is_buy) : 50.0

// 方向基准平均前瞻收益：无条件漂移基线，收益优势相对它计算（扣除漂移后只剩择时贡献）
// Direction baseline average forward return: the unconditional drift baseline; payoff edge is measured against it (subtracting drift isolates the timing contribution)
f_stats_baseline_avg(_is_buy) =>
    _baseline = array.get(baseline_stats, f_dir_bucket_index(_is_buy))
    _baseline.get_avg()

// 收缩后收益优势：置信度 ×（桶平均前瞻收益 − 方向基准平均前瞻收益），终身样本数<5时为na
// Shrunk payoff edge: confidence × (bucket avg forward return − direction baseline avg); na while the bucket's lifetime count is < 5
f_stats_payoff_edge(_stats, _is_buy) =>
    _stats.get_shrunk_payoff_edge_vs(f_stats_baseline_avg(_is_buy))

// 有效胜率门槛：Edge vs Baseline 模式 = 方向基准 + 要求优势，并钳制在 [25%, 90%]；旧版模式 = 固定绝对门槛
// 上限90%：调整胜率 = 先验 + 置信度×(原始-先验)，永远不会超过 max(基准, 原始胜率)，基准>95%时未钳制的门槛>100%在数学上不可满足，买入信号会被系统性拒绝
// 下限25%：基准接近0时未钳制的门槛≈优势值本身，个位数绝对胜率也会通过并获得质量勾号；25%远低于上升趋势中卖出方向的典型基准（30-45%），不会破坏相对（优势）门槛方法
// Effective win-rate requirement: Edge vs Baseline mode = direction baseline + required edge, clamped to [25%, 90%]; legacy mode = the fixed absolute threshold
// 90% cap: adjusted = prior + confidence*(raw - prior) can never exceed max(baseline, raw), so an unclamped requirement above 100% (baseline > 95%) is mathematically unsatisfiable and buy signals get systematically rejected
// 25% floor: with a near-zero baseline the unclamped requirement is just the edge itself, letting single-digit absolute win rates pass with a quality checkmark; 25% sits well below typical sell-side baselines on uptrends (30-45%), so the relative (edge) methodology is preserved
f_stats_required_winrate(_is_buy) =>
    stats_gate_mode == "Edge vs Baseline" ? math.max(math.min(f_stats_baseline_rate(_is_buy) + (stats_min_winrate - 50.0), 90.0), 25.0) : stats_min_winrate

// Adaptive 的动态目标只读取样本结构：桶本身的终身 n、同方向同 scope 四个 peer 的总 n，以及 Evidence Reference。
// q 使用总权重为 B 的对称先验平滑；默认 B=20 时目标范围 8–16。关闭独立采样时保护性回到 B，避免重叠窗口虚增证据。
// Dynamic Adaptive targets use sample structure only: bucket lifetime n, the total lifetime n of its four same-direction/same-scope peers, and Evidence Reference.
// q uses a symmetric prior with total weight B; default B=20 yields targets 8–16. With independent sampling off, the overlap guard restores B.
f_stats_adaptive_target_low() =>
    math.min(stats_min_samples, math.max(5, int(math.round(stats_min_samples * 0.4))))

f_stats_adaptive_target_high() =>
    _low = f_stats_adaptive_target_low()
    math.min(stats_min_samples, math.max(_low, int(math.round(stats_min_samples * 0.8))))

f_stats_dynamic_target(SignalStats _stats, int _peer_total) =>
    if stats_sample_policy == "Fixed (Legacy)" or not stats_independent_samples
        stats_min_samples
    else
        _low = f_stats_adaptive_target_low()
        _high = f_stats_adaptive_target_high()
        _bucket_n = _stats.get_lifetime_count()
        _q = (float(_bucket_n) + float(stats_min_samples) / STATS_EVIDENCE_PEER_COUNT) / (float(_peer_total) + float(stats_min_samples))
        _smoothed_q = math.max(0.0, math.min(_q, 1.0))
        int(math.round(_low + (_high - _low) * math.sqrt(_smoothed_q)))

f_stats_signal_type_peer_total(_is_buy) =>
    int _total = 0
    for _signal_idx = 0 to STATS_SIGNAL_COUNT - 1
        _peer = array.get(signal_type_stats, f_signal_type_bucket_index(_is_buy, _signal_idx))
        _total += _peer.get_lifetime_count()
    _total

f_stats_grade_peer_total(_is_buy) =>
    int _total = 0
    for _grade_idx = 0 to STATS_GRADE_COUNT - 1
        _peer = array.get(grade_stats, _grade_idx * STATS_DIR_COUNT + f_dir_bucket_index(_is_buy))
        _total += _peer.get_lifetime_count()
    _total

f_stats_ranking_peer_total(_is_buy, _signal_idx) =>
    int _total = 0
    for _grade_idx = 0 to STATS_GRADE_COUNT - 1
        _peer = array.get(ranking_stats, (_signal_idx * STATS_GRADE_COUNT + _grade_idx) * STATS_DIR_COUNT + f_dir_bucket_index(_is_buy))
        _total += _peer.get_lifetime_count()
    _total

f_stats_signal_type_target(_is_buy, _signal_idx) =>
    _stats = array.get(signal_type_stats, f_signal_type_bucket_index(_is_buy, _signal_idx))
    f_stats_dynamic_target(_stats, f_stats_signal_type_peer_total(_is_buy))

f_stats_grade_target(_is_buy, _grade) =>
    _stats = array.get(grade_stats, f_grade_bucket_index(_is_buy, _grade))
    f_stats_dynamic_target(_stats, f_stats_grade_peer_total(_is_buy))

f_stats_ranking_target(_is_buy, _signal_idx, _grade) =>
    _stats = array.get(ranking_stats, f_ranking_bucket_index(_is_buy, _signal_idx, _grade))
    f_stats_dynamic_target(_stats, f_stats_ranking_peer_total(_is_buy, _signal_idx))

// Fixed (Legacy) 只看固定终身门槛；Adaptive 同时要求动态终身目标与有效 n≥5。
// Fixed (Legacy) uses only its fixed lifetime threshold; Adaptive requires both its dynamic lifetime target and effective n >= 5.
f_stats_has_verdict_samples(SignalStats _stats, int _target) =>
    _stats.get_lifetime_count() >= _target and (stats_sample_policy == "Fixed (Legacy)" or _stats.get_count() >= 5)

// 样本标签始终显示 gate 实际使用的目标，避免 Adaptive 看起来仍固定为20。
// Sample labels always show the target actually used by the gate, so Adaptive cannot look fixed at 20.
f_stats_sample_text(SignalStats _stats, int _target) =>
    _n = _stats.get_lifetime_count()
    _n >= _target ? (stats_sample_policy == "Fixed (Legacy)" ? (_stats.get_count() >= 5 ? str.format("n={0}", _n) : str.format("n={0} · stale", _n)) : _stats.get_count() >= 5 ? str.format("n={0} · target {1}", _n, _target) : str.format("n={0} · eff {1,number,#.1}<5⏳", _n, _stats.get_count())) : str.format("n={0}/{1}⏳", _n, _target)

// 无择时优势提示只读取达到自身真实目标且有效权重仍≥5的成熟桶：至少2个，且全部胜率优势<0、收益优势≤0。
// 未成熟或已陈旧桶仍是“无结论”，不能据此发布方向级警告；该提示只描述已加载历史，不推断具体市场制度。
// The no-timing-edge hint reads only mature buckets that reached their actual target and retain effective weight >= 5: at least two, all with negative win-rate edge and non-positive payoff edge.
// Unproven or stale buckets remain inconclusive and cannot support a direction-level warning; the hint describes loaded history without diagnosing a regime.
f_stats_no_timing_edge(_is_buy) =>
    array<SignalStats> _buckets = stats_mode == "Signal Type" ? signal_type_stats : stats_mode == "Grade" ? grade_stats : ranking_stats
    _dir_idx = f_dir_bucket_index(_is_buy)
    _base_rate = f_stats_baseline_rate(_is_buy)
    int _mature_buckets = 0
    bool _all_lack_edge = true
    for i = 0 to array.size(_buckets) - 1
        if i % STATS_DIR_COUNT == _dir_idx
            _bucket = array.get(_buckets, i)
            _scope_idx = int(math.floor(i / STATS_DIR_COUNT))
            _target = stats_mode == "Signal Type" ? f_stats_signal_type_target(_is_buy, _scope_idx) : stats_mode == "Grade" ? f_stats_grade_target(_is_buy, f_grade_value(_scope_idx)) : f_stats_ranking_target(_is_buy, int(math.floor(_scope_idx / STATS_GRADE_COUNT)), f_grade_value(_scope_idx % STATS_GRADE_COUNT))
            if f_stats_has_verdict_samples(_bucket, _target) and _bucket.get_count() >= 5
                _mature_buckets += 1
                _wr_edge = _bucket.get_adjusted_winrate_vs(_base_rate) - _base_rate
                _payoff_edge = f_stats_payoff_edge(_bucket, _is_buy)
                if not (_wr_edge < 0 and _payoff_edge <= 0)
                    _all_lack_edge := false
    _mature_buckets >= 2 and _all_lack_edge

f_ranking_signal_number(_idx) =>
    _idx < 8 ? 1 : _idx < 16 ? 2 : _idx < 24 ? 3 : 4

f_ranking_grade_index(_idx) =>
    _idx_in_signal = _idx % STATS_RANKING_BUCKETS_PER_SIGNAL
    _idx_in_signal < 2 ? 0 : _idx_in_signal < 4 ? 1 : _idx_in_signal < 6 ? 2 : 3

f_ranking_direction_number(_idx) =>
    _idx % STATS_DIR_COUNT == STATS_DIR_BUY ? 1 : 2

f_signal_kind_name(_signal_idx) =>
    _signal_idx == STATS_SIGNAL_MTF ? "MTF" : _signal_idx == STATS_SIGNAL_DIV ? "DIV" : _signal_idx == STATS_SIGNAL_EXT ? "EXT" : "NORMAL"

f_signal_kind_icon(_signal_idx, _is_buy) =>
    _signal_idx == STATS_SIGNAL_MTF ? "🌟" : _signal_idx == STATS_SIGNAL_DIV ? "💎" : _signal_idx == STATS_SIGNAL_EXT ? (_is_buy ? "🔥" : "❄️") : _is_buy ? "⬆️" : "⬇️"

f_signal_type_dashboard_label(_signal_idx, _is_buy) =>
    str.format("{0} {1}\n{2}", f_signal_kind_icon(_signal_idx, _is_buy), f_signal_kind_name(_signal_idx), _is_buy ? "BUY" : "SELL")

f_signal_type_dashboard_color(_signal_idx, _is_buy, _bull, _bear) =>
    _signal_idx == STATS_SIGNAL_MTF ? #FFD700 :
     _signal_idx == STATS_SIGNAL_DIV ? #00BCD4 :
     _signal_idx == STATS_SIGNAL_EXT ? (_is_buy ? _bull : _bear) :
     color.new(_is_buy ? _bull : _bear, 30)

f_grade_dashboard_color(_grade_idx) =>
    _grade_idx == 0 ? #FFD700 : _grade_idx == 1 ? #4CAF50 : _grade_idx == 2 ? #FF9800 : #9E9E9E


// ────────────────────────────────────────
// DIVERGENCE DETECTION (v6.8 重构: 单锚点 + offset绘制)
// ────────────────────────────────────────

// 只用 price pivot 作为锚点，取该 bar 的 RSI 值进行比较
// 这样可以捕获更多有效背离，避免要求 RSI 和 price 同时 pivot
price_pivot_low = ta.pivotlow(low, div_lookback, div_lookback)
price_pivot_high = ta.pivothigh(high, div_lookback, div_lookback)

var float prev_price_low = na
var float prev_rsi_at_low = na  // 改名：在 price pivot 点的 RSI 值
var int prev_low_bar = na
var float prev_price_high = na
var float prev_rsi_at_high = na  // 改名：在 price pivot 点的 RSI 值
var int prev_high_bar = na

var bool bullish_divergence = false
var bool bearish_divergence = false

if enable_divergence
    // 看涨背离：价格创新低，但 RSI 未创新低（只需 price pivot）
    if not na(price_pivot_low)
        current_bar = bar_index - div_lookback
        current_rsi_at_pivot = rsi[div_lookback]  // 取 price pivot 点的 RSI
        if not na(prev_price_low) and not na(prev_rsi_at_low)
            bars_since = current_bar - prev_low_bar
            // 价格更低，但 RSI 更高 = 看涨背离
            if bars_since <= div_range and low[div_lookback] < prev_price_low and current_rsi_at_pivot > prev_rsi_at_low
                bullish_divergence := true
            else
                bullish_divergence := false
        else
            bullish_divergence := false
        prev_price_low := low[div_lookback]
        prev_rsi_at_low := current_rsi_at_pivot
        prev_low_bar := current_bar
    else
        bullish_divergence := false

    // 看跌背离：价格创新高，但 RSI 未创新高（只需 price pivot）
    if not na(price_pivot_high)
        current_bar = bar_index - div_lookback
        current_rsi_at_pivot = rsi[div_lookback]  // 取 price pivot 点的 RSI
        if not na(prev_price_high) and not na(prev_rsi_at_high)
            bars_since = current_bar - prev_high_bar
            // 价格更高，但 RSI 更低 = 看跌背离
            if bars_since <= div_range and high[div_lookback] > prev_price_high and current_rsi_at_pivot < prev_rsi_at_high
                bearish_divergence := true
            else
                bearish_divergence := false
        else
            bearish_divergence := false
        prev_price_high := high[div_lookback]
        prev_rsi_at_high := current_rsi_at_pivot
        prev_high_bar := current_bar
    else
        bearish_divergence := false

// ────────────────────────────────────────
// CONFIRMATION & REVERSAL SIGNALS
// ────────────────────────────────────────

rsi_pivot_low_current = ta.pivotlow(rsi, 3, 1)
rsi_pivot_high_current = ta.pivothigh(rsi, 3, 1)

// Percentile confirm for [1] indexed checks (inline to avoid ordering issues)
bool pct_ok_buy_1 = not enable_percentile_confirm or na(rsi_p5[1]) or (rsi[1] <= rsi_p5[1])
bool pct_ok_sell_1 = not enable_percentile_confirm or na(rsi_p95[1]) or (rsi[1] >= rsi_p95[1])

bool confirmation_buy = not na(rsi_pivot_low_current) and rsi_zscore[1] < -2 and pct_ok_buy_1
bool confirmation_sell = not na(rsi_pivot_high_current) and rsi_zscore[1] > 2 and pct_ok_sell_1

bool reversal_buy = ta.crossover(rsi_zscore, -2) and rsi_zscore[1] < -2 and pct_ok_buy_1
bool reversal_sell = ta.crossunder(rsi_zscore, 2) and rsi_zscore[1] > 2 and pct_ok_sell_1

// ────────────────────────────────────────
// REAL-TIME DIVERGENCE
// ────────────────────────────────────────

realtime_lookback = 20
lowest_price_20 = ta.lowest(low, realtime_lookback)
highest_price_20 = ta.highest(high, realtime_lookback)
lowest_rsi_20 = ta.lowest(rsi, realtime_lookback)
highest_rsi_20 = ta.highest(rsi, realtime_lookback)

price_near_low = low <= lowest_price_20 * 1.01
rsi_not_at_low = rsi > lowest_rsi_20 + 3
bool realtime_bullish_div = price_near_low and rsi_not_at_low and rsi_zscore < -1.5

price_near_high = high >= highest_price_20 * 0.99
rsi_not_at_high = rsi < highest_rsi_20 - 3
bool realtime_bearish_div = price_near_high and rsi_not_at_high and rsi_zscore > 1.5

// ────────────────────────────────────────
// VISUAL PLOTTING
// ────────────────────────────────────────

show_unified = visual_line_mode == "Unified"
show_zscore_lines = show_unified or visual_line_mode == "Z-Score" or visual_line_mode == "Both"
show_percentile_lines = visual_line_mode == "Percentile" or visual_line_mode == "Both"

zscore_extreme_color = show_zscore_lines ? (visual_line_mode == "Both" ? 50 : 70) : 100
zscore_normal_color = show_zscore_lines ? (visual_line_mode == "Both" ? 60 : 80) : 100

plot(show_zscore_lines ? zscore_upper_2 : na, "±2σ (≈P98)", color=color.new(color_bear, zscore_extreme_color), linewidth=2, style=plot.style_line)
plot(show_zscore_lines ? zscore_upper_1_5 : na, "±1.5σ (≈P93)", color=color.new(color_bear, zscore_normal_color), linewidth=1, style=plot.style_circles)
plot(show_zscore_lines ? zscore_lower_1_5 : na, "±1.5σ (≈P7)", color=color.new(color_bull, zscore_normal_color), linewidth=1, style=plot.style_circles)
plot(show_zscore_lines ? zscore_lower_2 : na, "±2σ (≈P2)", color=color.new(color_bull, zscore_extreme_color), linewidth=2, style=plot.style_line)

percentile_line_transparency = show_percentile_lines ? (visual_line_mode == "Both" ? 85 : 70) : 100

p95_line = plot(rsi_p95, "P95", color=color.new(color_bear, percentile_line_transparency), linewidth=1)
p90_line = plot(rsi_p90, "P90", color=color.new(color_bear, percentile_line_transparency), linewidth=1, style=plot.style_circles)
p75_line = plot(rsi_p75, "P75", color=color.new(color.gray, percentile_line_transparency), linewidth=1)
p50_line = plot(rsi_p50, "P50", color=color.new(color.white, 50), linewidth=2, style=plot.style_stepline)
p25_line = plot(rsi_p25, "P25", color=color.new(color.gray, percentile_line_transparency), linewidth=1)
p10_line = plot(rsi_p10, "P10", color=color.new(color_bull, percentile_line_transparency), linewidth=1, style=plot.style_circles)
p5_line  = plot(rsi_p5, "P5", color=color.new(color_bull, percentile_line_transparency), linewidth=1)

rsi_line = plot(rsi, "RSI", color=color_rsi, linewidth=2)

fill(p95_line, p90_line, color=show_fill ? color.new(color_bear, 75) : na, title="Extreme Overbought")
fill(p90_line, p75_line, color=show_fill ? color.new(color_bear, 88) : na, title="Overbought")
fill(p75_line, p50_line, color=show_fill ? color.new(color_bear, 95) : na, title="Upper")
fill(p50_line, p25_line, color=show_fill ? color.new(color_bull, 95) : na, title="Lower")
fill(p25_line, p10_line, color=show_fill ? color.new(color_bull, 88) : na, title="Oversold")
fill(p10_line, p5_line, color=show_fill ? color.new(color_bull, 75) : na, title="Extreme Oversold")

hline(0, "0", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
hline(100, "100", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
hline(50, "50", color=color.new(color.gray, 90), linestyle=hline.style_dotted)

// ────────────────────────────────────────
// SIGNAL DETECTION
// ────────────────────────────────────────

// Percentile confirmation conditions (NA-safe: fallback to Z-only when na)
pct_allows_buy = not enable_percentile_confirm or na(rsi_p5) or (rsi <= rsi_p5)
pct_allows_sell = not enable_percentile_confirm or na(rsi_p95) or (rsi >= rsi_p95)
// [div_lookback] indexed variants for divergence
pct_allows_buy_div = not enable_percentile_confirm or na(rsi_p5[div_lookback]) or (rsi[div_lookback] <= rsi_p5[div_lookback])
pct_allows_sell_div = not enable_percentile_confirm or na(rsi_p95[div_lookback]) or (rsi[div_lookback] >= rsi_p95[div_lookback])

raw_extreme_oversold = ta.crossunder(rsi_zscore, -2)
raw_extreme_overbought = ta.crossover(rsi_zscore, 2)
raw_normal_oversold = ta.crossunder(rsi_zscore, -normal_threshold) and not raw_extreme_oversold
raw_normal_overbought = ta.crossover(rsi_zscore, normal_threshold) and not raw_extreme_overbought

extreme_oversold = raw_extreme_oversold and (not enable_trend_protection or trend_allows_buy) and pct_allows_buy
extreme_overbought = raw_extreme_overbought and (not enable_trend_protection or trend_allows_sell) and pct_allows_sell
normal_oversold = enable_trend_protection ? (raw_normal_oversold and trend_allows_buy) : raw_normal_oversold
normal_overbought = enable_trend_protection ? (raw_normal_overbought and trend_allows_sell) : raw_normal_overbought

// ────────────────────────────────────────
// SIGNAL COOLDOWN
// ────────────────────────────────────────

var int last_mtf_buy_bar = na
var int last_mtf_sell_bar = na
var int last_div_buy_bar = na
var int last_div_sell_bar = na
var int last_ext_buy_bar = na
var int last_ext_sell_bar = na
var int last_norm_buy_bar = na
var int last_norm_sell_bar = na
var int last_buy_level = 0
var int last_sell_level = 0
var int last_buy_signal_bar = na
var int last_sell_signal_bar = na

// ────────────────────────────────────────
// CONSOLIDATED SIGNALS
// ────────────────────────────────────────

bool in_extreme_oversold = rsi_zscore < -2
bool in_extreme_overbought = rsi_zscore > 2

float zscore_at_div = rsi_stdev[div_lookback] != 0 ? (rsi[div_lookback] - rsi_mean[div_lookback]) / rsi_stdev[div_lookback] : 0
bool was_extreme_oversold = (zscore_at_div < -2) and pct_allows_buy_div
bool was_extreme_overbought = (zscore_at_div > 2) and pct_allows_sell_div

bool raw_sig_buy_mtf = enable_mtf and oversold_resonance and extreme_oversold
bool raw_sig_buy_div = enable_divergence and bullish_divergence and was_extreme_oversold and (not enable_trend_protection or trend_allows_buy) and not raw_sig_buy_mtf
bool raw_sig_buy_extreme = extreme_oversold and not raw_sig_buy_mtf and not raw_sig_buy_div
bool raw_sig_buy_normal = normal_oversold and not raw_sig_buy_mtf and not raw_sig_buy_div and not raw_sig_buy_extreme

bool raw_sig_sell_mtf = enable_mtf and overbought_resonance and extreme_overbought
bool raw_sig_sell_div = enable_divergence and bearish_divergence and was_extreme_overbought and (not enable_trend_protection or trend_allows_sell) and not raw_sig_sell_mtf
bool raw_sig_sell_extreme = extreme_overbought and not raw_sig_sell_mtf and not raw_sig_sell_div
bool raw_sig_sell_normal = normal_overbought and not raw_sig_sell_mtf and not raw_sig_sell_div and not raw_sig_sell_extreme

int cooldown_mtf = 1
int cooldown_div = 1
int cooldown_ext = 1
int cooldown_norm = cooldown_bars

// 升级豁免只比较仍在冷却期内的上一信号；冷却期已过的旧信号等级按 0 处理
// 等级为 0（无信号在冷却中）时不豁免，否则普通信号会绕过自身冷却期
// Upgrade exemption only compares against a still-cooling-down previous signal; expired levels count as 0
// No exemption when the effective level is 0 (nothing cooling), otherwise normal signals would bypass their own cooldown
int last_buy_level_cooldown = last_buy_level == 4 ? cooldown_mtf : last_buy_level == 3 ? cooldown_div : last_buy_level == 2 ? cooldown_ext : cooldown_norm
int effective_last_buy_level = na(last_buy_signal_bar) or bar_index - last_buy_signal_bar > last_buy_level_cooldown ? 0 : last_buy_level
int last_sell_level_cooldown = last_sell_level == 4 ? cooldown_mtf : last_sell_level == 3 ? cooldown_div : last_sell_level == 2 ? cooldown_ext : cooldown_norm
int effective_last_sell_level = na(last_sell_signal_bar) or bar_index - last_sell_signal_bar > last_sell_level_cooldown ? 0 : last_sell_level

int pending_buy_level = raw_sig_buy_mtf ? 4 : raw_sig_buy_div ? 3 : raw_sig_buy_extreme ? 2 : raw_sig_buy_normal ? 1 : 0
bool buy_upgrade_exempt = effective_last_buy_level > 0 and pending_buy_level > effective_last_buy_level

int pending_sell_level = raw_sig_sell_mtf ? 4 : raw_sig_sell_div ? 3 : raw_sig_sell_extreme ? 2 : raw_sig_sell_normal ? 1 : 0
bool sell_upgrade_exempt = effective_last_sell_level > 0 and pending_sell_level > effective_last_sell_level

bool sig_buy_mtf = enable_signal_cooldown ? (raw_sig_buy_mtf and (buy_upgrade_exempt or na(last_mtf_buy_bar) or bar_index - last_mtf_buy_bar >= cooldown_mtf)) : raw_sig_buy_mtf
bool sig_buy_div = enable_signal_cooldown ? (raw_sig_buy_div and (buy_upgrade_exempt or na(last_div_buy_bar) or bar_index - last_div_buy_bar >= cooldown_div)) : raw_sig_buy_div
bool sig_buy_extreme = enable_signal_cooldown ? (raw_sig_buy_extreme and (buy_upgrade_exempt or na(last_ext_buy_bar) or bar_index - last_ext_buy_bar >= cooldown_ext)) : raw_sig_buy_extreme
bool sig_buy_normal = enable_signal_cooldown ? (raw_sig_buy_normal and (buy_upgrade_exempt or na(last_norm_buy_bar) or bar_index - last_norm_buy_bar >= cooldown_norm)) : raw_sig_buy_normal

bool sig_sell_mtf = enable_signal_cooldown ? (raw_sig_sell_mtf and (sell_upgrade_exempt or na(last_mtf_sell_bar) or bar_index - last_mtf_sell_bar >= cooldown_mtf)) : raw_sig_sell_mtf
bool sig_sell_div = enable_signal_cooldown ? (raw_sig_sell_div and (sell_upgrade_exempt or na(last_div_sell_bar) or bar_index - last_div_sell_bar >= cooldown_div)) : raw_sig_sell_div
bool sig_sell_extreme = enable_signal_cooldown ? (raw_sig_sell_extreme and (sell_upgrade_exempt or na(last_ext_sell_bar) or bar_index - last_ext_sell_bar >= cooldown_ext)) : raw_sig_sell_extreme
bool sig_sell_normal = enable_signal_cooldown ? (raw_sig_sell_normal and (sell_upgrade_exempt or na(last_norm_sell_bar) or bar_index - last_norm_sell_bar >= cooldown_norm)) : raw_sig_sell_normal

if signal_data_ready and sig_buy_mtf
    last_mtf_buy_bar := bar_index
    last_buy_signal_bar := bar_index
    last_buy_level := 4
if signal_data_ready and sig_buy_div
    last_div_buy_bar := bar_index
    last_buy_signal_bar := bar_index
    last_buy_level := 3
if signal_data_ready and sig_buy_extreme
    last_ext_buy_bar := bar_index
    last_buy_signal_bar := bar_index
    last_buy_level := 2
if signal_data_ready and sig_buy_normal
    last_norm_buy_bar := bar_index
    last_buy_signal_bar := bar_index
    last_buy_level := 1

if signal_data_ready and sig_sell_mtf
    last_mtf_sell_bar := bar_index
    last_sell_signal_bar := bar_index
    last_sell_level := 4
if signal_data_ready and sig_sell_div
    last_div_sell_bar := bar_index
    last_sell_signal_bar := bar_index
    last_sell_level := 3
if signal_data_ready and sig_sell_extreme
    last_ext_sell_bar := bar_index
    last_sell_signal_bar := bar_index
    last_sell_level := 2
if signal_data_ready and sig_sell_normal
    last_norm_sell_bar := bar_index
    last_sell_signal_bar := bar_index
    last_sell_level := 1

bool sig_div_bull_only = enable_divergence and bullish_divergence and not was_extreme_oversold
bool sig_div_bear_only = enable_divergence and bearish_divergence and not was_extreme_overbought

// 普通信号被 Smart 模式隐藏的状态
bool normal_buy_hidden = sig_buy_normal and not show_normal_signals
bool normal_sell_hidden = sig_sell_normal and not show_normal_signals
string hide_reason = weekly_extreme_bearish ? "周线极端↓" : weekly_extreme_bullish ? "周线极端↑" : ""

// 普通超卖/超买区域持续状态（非信号触发时刻）
bool in_normal_oversold = rsi_zscore < -normal_threshold and rsi_zscore >= -2
bool in_normal_overbought = rsi_zscore > normal_threshold and rsi_zscore <= 2

// ────────────────────────────────────────
// SIGNAL QUALITY SCORING
// ────────────────────────────────────────

f_buy_quality() =>
    score = 0
    if rsi_zscore < -2
        score := 50
    if rsi_zscore < -2.5
        score += 20
    else if rsi_zscore < -2
        score += 10
    if bullish_divergence or oversold_resonance
        score += 25
    // v6.9: RSI 拐点确认 - 极端区形成底部拐点
    if confirmation_buy
        score += 10
    if weekly_uptrend
        score += 15
    if enable_volume_scoring and volume_surge
        score += 10
    if weekly_extreme_bearish
        score -= 20
    if enable_volume_scoring and volume_low
        score -= 10
    if not health_sample_coverage or not health_distribution_spread or not health_stat_valid
        score -= 15
    // v6.9: ADX 趋势惩罚 - 强下跌趋势中抄底减分
    if adx_is_trending and adx_trend_down
        score -= 10
    math.max(score, 0)

f_sell_quality() =>
    score = 0
    if rsi_zscore > 2
        score := 50
    if rsi_zscore > 2.5
        score += 20
    else if rsi_zscore > 2
        score += 10
    if bearish_divergence or overbought_resonance
        score += 25
    // v6.9: RSI 拐点确认 - 极端区形成顶部拐点
    if confirmation_sell
        score += 10
    if weekly_downtrend
        score += 15
    if enable_volume_scoring and volume_surge
        score += 10
    if weekly_extreme_bullish
        score -= 20
    if enable_volume_scoring and volume_low
        score -= 10
    if not health_sample_coverage or not health_distribution_spread or not health_stat_valid
        score -= 15
    // v6.9: ADX 趋势惩罚 - 强上涨趋势中做空减分
    if adx_is_trending and adx_trend_up
        score -= 10
    math.max(score, 0)

current_buy_quality = f_buy_quality()
current_sell_quality = f_sell_quality()

f_quality_grade(_score) =>
    _score >= 80 ? "A" : _score >= 60 ? "B" : _score >= 40 ? "C" : "D"

f_dir_color(_dir, _bull, _bear) =>
    _dir == 1 ? _bull : _bear

buy_quality_grade = f_quality_grade(current_buy_quality)
sell_quality_grade = f_quality_grade(current_sell_quality)

// ────────────────────────────────────────
// ATR RISK CALCULATION
// ────────────────────────────────────────

atr_14 = ta.atr(14)
atr_pct = atr_14 / close * 100

// 止损倍数根据信号质量等级调整
f_sl_multiplier(_grade) =>
    _grade == "A" ? 2.5 : _grade == "B" ? 2.0 : _grade == "C" ? 1.5 : 1.2

// 计算止损/止盈（多头）
buy_sl_mult = f_sl_multiplier(buy_quality_grade)
buy_sl_distance = atr_14 * buy_sl_mult
buy_sl_price = close - buy_sl_distance
buy_sl_pct = buy_sl_distance / close * 100
buy_tp_distance = buy_sl_distance * alert_rr_ratio
buy_tp_price = close + buy_tp_distance
buy_tp_pct = buy_tp_distance / close * 100

// 计算止损/止盈（空头/退出多头）
sell_sl_mult = f_sl_multiplier(sell_quality_grade)
sell_sl_distance = atr_14 * sell_sl_mult
sell_sl_price = close + sell_sl_distance  // 空头止损在上方
sell_sl_pct = sell_sl_distance / close * 100
sell_tp_distance = sell_sl_distance * alert_rr_ratio
sell_tp_price = close - sell_tp_distance
sell_tp_pct = sell_tp_distance / close * 100

active_signal_grade = sig_buy_mtf or sig_buy_div or sig_buy_extreme or sig_buy_normal ? buy_quality_grade :
                      sig_sell_mtf or sig_sell_div or sig_sell_extreme or sig_sell_normal ? sell_quality_grade :
                      normal_buy_hidden ? buy_quality_grade :
                      normal_sell_hidden ? sell_quality_grade :
                      in_extreme_oversold ? buy_quality_grade :
                      in_extreme_overbought ? sell_quality_grade :
                      in_normal_oversold ? buy_quality_grade :
                      in_normal_overbought ? sell_quality_grade : ""

// ────────────────────────────────────────
// STATISTICS CALCULATION
// ────────────────────────────────────────

has_buy_signal = sig_buy_mtf or sig_buy_div or sig_buy_extreme or sig_buy_normal
has_sell_signal = sig_sell_mtf or sig_sell_div or sig_sell_extreme or sig_sell_normal

// Both candidates and their unconditional baseline use the same entry-time context.
// A later context gap must not censor an already eligible signal's price outcome.
// 信号与无条件基准共享发生时的数据资格；后续上下文缺失不删去已合格样本的收益。
if enable_stats and bar_index > stats_forward_bars and signal_data_ready[stats_forward_bars] and not na(close) and close[stats_forward_bars] > 0
    forward_return_long = (close - close[stats_forward_bars]) / close[stats_forward_bars] * 100
    // Sell统计口径：Long Exit = 价格下跌为正（卖出正确），Short Entry = 做空收益
    // Long Exit: 信号后价格下跌 = 卖出决策正确，用同样的公式但从多头退出角度解读
    // Short Entry: 原有逻辑，做空收益
    forward_return_short = (close[stats_forward_bars] - close) / close[stats_forward_bars] * 100

    // 方向基准桶：每根可计算K线都记录无条件前瞻收益（同样衰减，不做独立采样间隔）
    baseline_buy_bucket = array.get(baseline_stats, STATS_DIR_BUY)
    baseline_buy_bucket.update(true, forward_return_long, false)
    baseline_sell_bucket = array.get(baseline_stats, STATS_DIR_SELL)
    baseline_sell_bucket.update(true, forward_return_short, false)

    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(true, STATS_SIGNAL_MTF), sig_buy_mtf[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(false, STATS_SIGNAL_MTF), sig_sell_mtf[stats_forward_bars], forward_return_short)
    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(true, STATS_SIGNAL_DIV), sig_buy_div[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(false, STATS_SIGNAL_DIV), sig_sell_div[stats_forward_bars], forward_return_short)
    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(true, STATS_SIGNAL_EXT), sig_buy_extreme[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(false, STATS_SIGNAL_EXT), sig_sell_extreme[stats_forward_bars], forward_return_short)
    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(true, STATS_SIGNAL_NORM), sig_buy_normal[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(signal_type_stats, f_signal_type_bucket_index(false, STATS_SIGNAL_NORM), sig_sell_normal[stats_forward_bars], forward_return_short)

    past_buy_signal = has_buy_signal[stats_forward_bars]
    past_buy_grade = buy_quality_grade[stats_forward_bars]
    if past_buy_signal
        f_update_stats_bucket(grade_stats, f_grade_bucket_index(true, past_buy_grade), true, forward_return_long)

    past_sell_signal = has_sell_signal[stats_forward_bars]
    past_sell_grade = sell_quality_grade[stats_forward_bars]
    if past_sell_signal
        f_update_stats_bucket(grade_stats, f_grade_bucket_index(false, past_sell_grade), true, forward_return_short)

    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(true, STATS_SIGNAL_MTF, past_buy_grade), sig_buy_mtf[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(false, STATS_SIGNAL_MTF, past_sell_grade), sig_sell_mtf[stats_forward_bars], forward_return_short)
    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(true, STATS_SIGNAL_DIV, past_buy_grade), sig_buy_div[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(false, STATS_SIGNAL_DIV, past_sell_grade), sig_sell_div[stats_forward_bars], forward_return_short)
    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(true, STATS_SIGNAL_EXT, past_buy_grade), sig_buy_extreme[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(false, STATS_SIGNAL_EXT, past_sell_grade), sig_sell_extreme[stats_forward_bars], forward_return_short)
    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(true, STATS_SIGNAL_NORM, past_buy_grade), sig_buy_normal[stats_forward_bars], forward_return_long)
    f_update_stats_bucket(ranking_stats, f_ranking_bucket_index(false, STATS_SIGNAL_NORM, past_sell_grade), sig_sell_normal[stats_forward_bars], forward_return_short)

// ────────────────────────────────────────
// STATISTICS-DRIVEN FILTER
// ────────────────────────────────────────

// 获取当前信号对应的统计数据
f_get_signal_stats(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    array.get(ranking_stats, f_ranking_bucket_index(_is_buy, f_signal_kind_index(_is_mtf, _is_div, _is_ext), _grade))

f_get_signal_type_stats(_is_buy, _is_mtf, _is_div, _is_ext) =>
    array.get(signal_type_stats, f_signal_type_bucket_index(_is_buy, f_signal_kind_index(_is_mtf, _is_div, _is_ext)))

f_get_grade_stats(_is_buy, _grade) =>
    array.get(grade_stats, f_grade_bucket_index(_is_buy, _grade))

f_get_signal_target(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    f_stats_ranking_target(_is_buy, f_signal_kind_index(_is_mtf, _is_div, _is_ext), _grade)

f_get_signal_type_target(_is_buy, _is_mtf, _is_div, _is_ext) =>
    f_stats_signal_type_target(_is_buy, f_signal_kind_index(_is_mtf, _is_div, _is_ext))

f_get_grade_target(_is_buy, _grade) =>
    f_stats_grade_target(_is_buy, _grade)

// Adaptive Ranking 只在精确桶无结论且同方向 Signal Type 父桶已有结论时回退。
// Bucket selection never depends on performance, only on lifetime/effective sample readiness.
f_stats_uses_type_fallback(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    _ranking = f_get_signal_stats(_is_buy, _is_mtf, _is_div, _is_ext, _grade)
    _type = f_get_signal_type_stats(_is_buy, _is_mtf, _is_div, _is_ext)
    _ranking_target = f_get_signal_target(_is_buy, _is_mtf, _is_div, _is_ext, _grade)
    _type_target = f_get_signal_type_target(_is_buy, _is_mtf, _is_div, _is_ext)
    stats_sample_policy == "Adaptive" and stats_mode == "Ranking" and not f_stats_has_verdict_samples(_ranking, _ranking_target) and f_stats_has_verdict_samples(_type, _type_target)

f_get_filter_stats(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    if stats_mode == "Signal Type"
        f_get_signal_type_stats(_is_buy, _is_mtf, _is_div, _is_ext)
    else if stats_mode == "Grade"
        f_get_grade_stats(_is_buy, _grade)
    else if f_stats_uses_type_fallback(_is_buy, _is_mtf, _is_div, _is_ext, _grade)
        f_get_signal_type_stats(_is_buy, _is_mtf, _is_div, _is_ext)
    else
        f_get_signal_stats(_is_buy, _is_mtf, _is_div, _is_ext, _grade)

f_get_filter_target(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    if stats_mode == "Signal Type"
        f_get_signal_type_target(_is_buy, _is_mtf, _is_div, _is_ext)
    else if stats_mode == "Grade"
        f_get_grade_target(_is_buy, _grade)
    else if f_stats_uses_type_fallback(_is_buy, _is_mtf, _is_div, _is_ext, _grade)
        f_get_signal_type_target(_is_buy, _is_mtf, _is_div, _is_ext)
    else
        f_get_signal_target(_is_buy, _is_mtf, _is_div, _is_ext, _grade)

f_get_filter_source(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    f_stats_uses_type_fallback(_is_buy, _is_mtf, _is_div, _is_ext, _grade) ? "Type fallback" : ""
// @harness: stats-helpers

f_get_signal_type_label(_is_mtf, _is_div, _is_ext) =>
    _is_mtf ? "MTF" : _is_div ? "DIV" : _is_ext ? "EXT" : "NORMAL"

// Raw Baseline and disabled production filters describe the bucket requested by
// Stats Mode. Only an active Production gate may resolve to an Adaptive parent.
// Raw Baseline 与关闭过滤的 Production 始终描述 Stats Mode 请求桶；只有启用中的
// Production gate 才可解析到 Adaptive 父级证据桶。
f_harness_get_requested_stats(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    if stats_mode == "Signal Type"
        f_get_signal_type_stats(_is_buy, _is_mtf, _is_div, _is_ext)
    else if stats_mode == "Grade"
        f_get_grade_stats(_is_buy, _grade)
    else
        f_get_signal_stats(_is_buy, _is_mtf, _is_div, _is_ext, _grade)

f_harness_get_requested_target(_is_buy, _is_mtf, _is_div, _is_ext, _grade) =>
    if stats_mode == "Signal Type"
        f_get_signal_type_target(_is_buy, _is_mtf, _is_div, _is_ext)
    else if stats_mode == "Grade"
        f_get_grade_target(_is_buy, _grade)
    else
        f_get_signal_target(_is_buy, _is_mtf, _is_div, _is_ext, _grade)

f_get_filter_source_label(_is_mtf, _is_div, _is_ext, _grade, _is_buy, _evidence_source) =>
    _type_label = f_get_signal_type_label(_is_mtf, _is_div, _is_ext)
    _bucket_label = stats_mode == "Signal Type" ? _type_label :
                    stats_mode == "Grade" ? str.format("Score {0}", _grade) :
                    str.format("{0} [Score {1}]", _type_label, _grade)
    _display_bucket = _evidence_source == "Type fallback" ? str.format("{0} [Score {1}] → Type", _type_label, _grade) : _bucket_label
    str.format("{0} · {1}", _is_buy ? "BUY" : "SELL", _display_bucket)

// 质量路径的单一事实来源：过滤器与面板共用同一组未舍入布尔值，避免显示与实际动作漂移。
// Single source of truth for quality paths: the filter and dashboard share the same unrounded booleans.
f_stats_gate_paths(SignalStats _stats, bool _is_buy, int _target) =>
    _edge_mode = stats_gate_mode == "Edge vs Baseline"
    _prior = _edge_mode ? f_stats_baseline_rate(_is_buy) : 50.0
    _required = f_stats_required_winrate(_is_buy)
    _adj_wr = _stats.get_adjusted_winrate_vs(_prior)
    _has_enough_samples = f_stats_has_verdict_samples(_stats, _target)
    _has_good_winrate = not na(_adj_wr) and _adj_wr >= _required
    _payoff_edge = f_stats_payoff_edge(_stats, _is_buy)
    _has_good_payoff = not na(_payoff_edge) and _payoff_edge >= stats_min_payoff_edge
    _payoff_active = _edge_mode and stats_payoff_mode != "Off"
    _quality_ok = not _payoff_active ? _has_good_winrate : stats_payoff_mode == "Either Edge" ? _has_good_winrate or _has_good_payoff : _has_good_winrate and _has_good_payoff
    [_has_enough_samples, _edge_mode, _payoff_active, _has_good_winrate, _has_good_payoff, _quality_ok, _adj_wr, _payoff_edge]

// 检查信号是否通过统计过滤
// Edge vs Baseline: 先验收缩到方向基准胜率，门槛 = 基准 + (最小调整胜率 - 50)，钳制在 [25%, 90%]（见 f_stats_required_winrate）
//   Payoff Gate ≠ Off 时增加收益优势路径：收缩后收益优势 ≥ 最小收益优势即通过（Either Edge = 任一路径，Both Edges = 两路径都过）
// Absolute (Legacy): 先验50%，门槛 = 最小调整胜率（旧版行为）；收益优势路径不生效，保持纯 v7.3 语义
// 证据未经判定（终身样本数不足，或 Adaptive 下有效样本数<5）时：Unproven Buckets = Pass 放行，Block (Legacy) 拦截。
// 样本足够时收益优势仍只是质量判定的替代路径，不是样本充分性的替代
// Without verdict-ready evidence (insufficient lifetime samples, or effective n < 5 under Adaptive), Unproven Buckets decides whether to pass or block.
// With sufficient samples the payoff edge remains an alternative quality criterion, never an alternative to sample sufficiency
f_passes_stats_filter(_stats, _is_buy, _target) =>
    if not enable_stats_filter or not enable_stats
        true
    else
        [_has_enough_samples, _edge_mode, _payoff_active, _has_good_winrate, _has_good_payoff, _quality_ok, _adj_wr, _payoff_edge] = f_stats_gate_paths(_stats, _is_buy, _target)
        _has_enough_samples ? _quality_ok : stats_unproven_mode == "Pass"

// 桶统计行直接翻译生产门槛：最终动作取自 f_passes_stats_filter，路径值和门槛与该函数同口径。
// Edge 证据最多三行：先给结论/组合逻辑，再分别显示 WR edge 与 Avg edge；不重复原始 WR/Avg。
// Translate each bucket into the production gate decision. The overall action comes from f_passes_stats_filter;
// path values and thresholds use the same inputs. Edge evidence uses at most three lines and avoids repeating raw WR/Avg.
f_stats_direct_readout(SignalStats _stats, bool _is_buy, int _target) =>
    _gate_pass = f_passes_stats_filter(_stats, _is_buy, _target)
    _lifetime_n = _stats.get_lifetime_count()
    _has_estimate = _lifetime_n >= 5
    [_has_enough_samples, _edge_mode, _payoff_active, _wr_pass, _payoff_pass, _quality_ok, _display_wr, _payoff_edge] = f_stats_gate_paths(_stats, _is_buy, _target)
    if not enable_stats
        "STATS OFF · ALL ALLOWED\nNo quality verdict"
    else if not enable_stats_filter
        if not _has_estimate
            "FILTER OFF · ALL ALLOWED\nNo usable estimate"
        else if _edge_mode
            _wr_edge = _display_wr - f_stats_baseline_rate(_is_buy)
            str.format("FILTER OFF · ALL ALLOWED\nWR edge {0,number,+#.2;-#.2}pp\nAvg edge {1,number,+#.2;-#.2}%", _wr_edge, _payoff_edge)
        else
            str.format("FILTER OFF · ALL ALLOWED\nWR {0,number,#.2}% · no gate", _display_wr)
    else if not _has_enough_samples
        _lifetime_n < _target ? str.format("{0} · WAITING\nNo quality verdict", _gate_pass ? "ALLOW" : "BLOCK") : str.format("{0} · STALE\nNeed fresh evidence", _gate_pass ? "ALLOW" : "BLOCK")
    else
        _required_wr = f_stats_required_winrate(_is_buy)
        _path_count = (_wr_pass ? 1 : 0) + (_payoff_pass ? 1 : 0)
        _logic = not _payoff_active ? "WR ONLY" : stats_payoff_mode == "Either Edge" ? str.format("OR ({0}/2)", _path_count) : str.format("AND ({0}/2)", _path_count)
        _headline = str.format("{0} · {1}", _gate_pass ? "PASS" : "BLOCK", _edge_mode ? _logic : "ABS WR")
        if _edge_mode
            _wr_edge = _display_wr - f_stats_baseline_rate(_is_buy)
            _avg_path = _payoff_active ? str.format("Avg edge {0,number,+#.2;-#.2}% {1}", _payoff_edge, _payoff_pass ? "✓" : "✗") : str.format("Avg edge {0,number,+#.2;-#.2}% · info", _payoff_edge)
            _headline + str.format("\nWR edge {0,number,+#.2;-#.2}pp {1}\n{2}", _wr_edge, _wr_pass ? "✓" : "✗", _avg_path)
        else
            _headline + str.format("\nWR {0,number,#.2}% {1} {2,number,#.2}% {3}", _display_wr, _wr_pass ? "≥" : "<", _required_wr, _wr_pass ? "✓" : "✗")

// 一个 cell 只能使用一种文字颜色；成熟桶保持白色，避免 OR 模式下失败路径的 ✗ 被整体 PASS 绿色误导。
// A cell has one text color, so mature buckets stay white: an OR-pass must not paint its failed path and ✗ green.
f_stats_direct_color(SignalStats _stats, bool _is_buy, int _target) =>
    _gate_pass = f_passes_stats_filter(_stats, _is_buy, _target)
    not enable_stats or not enable_stats_filter ? color.gray :
     not f_stats_has_verdict_samples(_stats, _target) ? (_gate_pass ? #FFC107 : #9E9E9E) :
     _stats.get_count() < 5 ? #FFC107 :
     color.white

// 计算各信号的过滤状态
buy_mtf_stats = f_get_filter_stats(true, true, false, false, buy_quality_grade)
buy_div_stats = f_get_filter_stats(true, false, true, false, buy_quality_grade)
buy_ext_stats = f_get_filter_stats(true, false, false, true, buy_quality_grade)
buy_norm_stats = f_get_filter_stats(true, false, false, false, buy_quality_grade)
buy_mtf_stats_target = f_get_filter_target(true, true, false, false, buy_quality_grade)
buy_div_stats_target = f_get_filter_target(true, false, true, false, buy_quality_grade)
buy_ext_stats_target = f_get_filter_target(true, false, false, true, buy_quality_grade)
buy_norm_stats_target = f_get_filter_target(true, false, false, false, buy_quality_grade)
buy_mtf_stats_source = f_get_filter_source(true, true, false, false, buy_quality_grade)
buy_div_stats_source = f_get_filter_source(true, false, true, false, buy_quality_grade)
buy_ext_stats_source = f_get_filter_source(true, false, false, true, buy_quality_grade)
buy_norm_stats_source = f_get_filter_source(true, false, false, false, buy_quality_grade)

sell_mtf_stats = f_get_filter_stats(false, true, false, false, sell_quality_grade)
sell_div_stats = f_get_filter_stats(false, false, true, false, sell_quality_grade)
sell_ext_stats = f_get_filter_stats(false, false, false, true, sell_quality_grade)
sell_norm_stats = f_get_filter_stats(false, false, false, false, sell_quality_grade)
sell_mtf_stats_target = f_get_filter_target(false, true, false, false, sell_quality_grade)
sell_div_stats_target = f_get_filter_target(false, false, true, false, sell_quality_grade)
sell_ext_stats_target = f_get_filter_target(false, false, false, true, sell_quality_grade)
sell_norm_stats_target = f_get_filter_target(false, false, false, false, sell_quality_grade)
sell_mtf_stats_source = f_get_filter_source(false, true, false, false, sell_quality_grade)
sell_div_stats_source = f_get_filter_source(false, false, true, false, sell_quality_grade)
sell_ext_stats_source = f_get_filter_source(false, false, false, true, sell_quality_grade)
sell_norm_stats_source = f_get_filter_source(false, false, false, false, sell_quality_grade)

// 过滤结果
filter_buy_mtf = signal_data_ready and f_passes_stats_filter(buy_mtf_stats, true, buy_mtf_stats_target)
filter_buy_div = signal_data_ready and f_passes_stats_filter(buy_div_stats, true, buy_div_stats_target)
filter_buy_ext = signal_data_ready and f_passes_stats_filter(buy_ext_stats, true, buy_ext_stats_target)
filter_buy_norm = signal_data_ready and f_passes_stats_filter(buy_norm_stats, true, buy_norm_stats_target)

filter_sell_mtf = signal_data_ready and f_passes_stats_filter(sell_mtf_stats, false, sell_mtf_stats_target)
filter_sell_div = signal_data_ready and f_passes_stats_filter(sell_div_stats, false, sell_div_stats_target)
filter_sell_ext = signal_data_ready and f_passes_stats_filter(sell_ext_stats, false, sell_ext_stats_target)
filter_sell_norm = signal_data_ready and f_passes_stats_filter(sell_norm_stats, false, sell_norm_stats_target)

// 根据过滤模式决定显示的信号
// Hard: 只显示通过的信号
// Soft: 所有信号都显示，但通过的正常显示，未通过的降级显示
// Alert Only: 所有信号正常显示，仅Alert过滤
show_buy_mtf = stats_filter_mode == "Hard" ? (sig_buy_mtf and filter_buy_mtf) : sig_buy_mtf
show_buy_div = stats_filter_mode == "Hard" ? (sig_buy_div and filter_buy_div) : sig_buy_div
show_buy_ext = stats_filter_mode == "Hard" ? (sig_buy_extreme and filter_buy_ext) : sig_buy_extreme
show_buy_norm = stats_filter_mode == "Hard" ? (sig_buy_normal and filter_buy_norm) : sig_buy_normal

show_sell_mtf = stats_filter_mode == "Hard" ? (sig_sell_mtf and filter_sell_mtf) : sig_sell_mtf
show_sell_div = stats_filter_mode == "Hard" ? (sig_sell_div and filter_sell_div) : sig_sell_div
show_sell_ext = stats_filter_mode == "Hard" ? (sig_sell_extreme and filter_sell_ext) : sig_sell_extreme
show_sell_norm = stats_filter_mode == "Hard" ? (sig_sell_normal and filter_sell_norm) : sig_sell_normal

// Soft模式：降级显示（未通过过滤的信号）
soft_degraded_buy_mtf = stats_filter_mode == "Soft" and sig_buy_mtf and not filter_buy_mtf
soft_degraded_buy_div = stats_filter_mode == "Soft" and sig_buy_div and not filter_buy_div
soft_degraded_buy_ext = stats_filter_mode == "Soft" and sig_buy_extreme and not filter_buy_ext
soft_degraded_buy_norm = stats_filter_mode == "Soft" and sig_buy_normal and not filter_buy_norm

soft_degraded_sell_mtf = stats_filter_mode == "Soft" and sig_sell_mtf and not filter_sell_mtf
soft_degraded_sell_div = stats_filter_mode == "Soft" and sig_sell_div and not filter_sell_div
soft_degraded_sell_ext = stats_filter_mode == "Soft" and sig_sell_extreme and not filter_sell_ext
soft_degraded_sell_norm = stats_filter_mode == "Soft" and sig_sell_normal and not filter_sell_norm

// Alert过滤：所有模式都应用
alert_buy_mtf = sig_buy_mtf and filter_buy_mtf
alert_buy_div = sig_buy_div and filter_buy_div
alert_buy_ext = sig_buy_extreme and filter_buy_ext
alert_buy_norm = sig_buy_normal and filter_buy_norm

alert_sell_mtf = sig_sell_mtf and filter_sell_mtf
alert_sell_div = sig_sell_div and filter_sell_div
alert_sell_ext = sig_sell_extreme and filter_sell_ext
alert_sell_norm = sig_sell_normal and filter_sell_norm

production_signal_conflict = (alert_buy_mtf or alert_buy_div or alert_buy_ext or (show_normal_signals and alert_buy_norm)) and (alert_sell_mtf or alert_sell_div or alert_sell_ext or (show_normal_signals and alert_sell_norm))

// 当前信号的统计桶是否样本不足（⏳ = 无质量结论）；与 f_passes_stats_filter 的样本门槛同口径
// Whether the current signal's bucket lacks samples (⏳ = no quality verdict); same basis as the sample gate in f_passes_stats_filter
f_stats_insufficient(_stats, _target) =>
    not f_stats_has_verdict_samples(_stats, _target)

// ────────────────────────────────────────
// 信号隐藏状态检测（用于统一显示）
// ────────────────────────────────────────

// 极端信号被趋势保护隐藏
bool extreme_buy_hidden = enable_trend_protection and raw_extreme_oversold and not trend_allows_buy
bool extreme_sell_hidden = enable_trend_protection and raw_extreme_overbought and not trend_allows_sell

// ────────────────────────────────────────
// SIGNAL DISPLAY
// ────────────────────────────────────────

// 正常显示的信号（通过过滤或非Hard模式且通过）
plotshape(show_buy_mtf and not soft_degraded_buy_mtf, title="🌟 MTF+极端超卖", style=shape.labelup, location=location.bottom, color=#00E676, size=size.normal, text="🌟", textcolor=color.white)
plotshape(show_buy_div and not soft_degraded_buy_div, title="💎 背离+极端超卖", style=shape.labelup, location=location.bottom, color=#00BCD4, size=size.normal, text="💎", textcolor=color.white)
plotshape(show_buy_ext and not soft_degraded_buy_ext, title="🔥 极端超卖", style=shape.triangleup, location=location.bottom, color=color_bull, size=size.small, text="🔥")
plotshape(show_normal_signals and show_buy_norm and not soft_degraded_buy_norm, title="⬆️ 普通超卖", style=shape.circle, location=location.bottom, color=color.new(color_bull, 30), size=size.tiny, text="⬆️")

// 卖出信号 (顶部)
plotshape(show_sell_mtf and not soft_degraded_sell_mtf, title="🌟 MTF+极端超买", style=shape.labeldown, location=location.top, color=#FF5252, size=size.normal, text="🌟", textcolor=color.white)
plotshape(show_sell_div and not soft_degraded_sell_div, title="💎 背离+极端超买", style=shape.labeldown, location=location.top, color=#FF9800, size=size.normal, text="💎", textcolor=color.white)
plotshape(show_sell_ext and not soft_degraded_sell_ext, title="❄️ 极端超买", style=shape.triangledown, location=location.top, color=color_bear, size=size.small, text="❄️")
plotshape(show_normal_signals and show_sell_norm and not soft_degraded_sell_norm, title="⬇️ 普通超买", style=shape.circle, location=location.top, color=color.new(color_bear, 30), size=size.tiny, text="⬇️")

// Soft模式降级显示（半透明、更小）
plotshape(soft_degraded_buy_mtf, title="🌟 MTF+极端超卖(降级)", style=shape.labelup, location=location.bottom, color=color.new(#00E676, 70), size=size.tiny, text="🌟", textcolor=color.new(color.white, 50))
plotshape(soft_degraded_buy_div, title="💎 背离+极端超卖(降级)", style=shape.labelup, location=location.bottom, color=color.new(#00BCD4, 70), size=size.tiny, text="💎", textcolor=color.new(color.white, 50))
plotshape(soft_degraded_buy_ext, title="🔥 极端超卖(降级)", style=shape.triangleup, location=location.bottom, color=color.new(color_bull, 70), size=size.tiny, text="🔥")
plotshape(show_normal_signals and soft_degraded_buy_norm, title="⬆️ 普通超卖(降级)", style=shape.circle, location=location.bottom, color=color.new(color_bull, 80), size=size.tiny, text="⬆️")

plotshape(soft_degraded_sell_mtf, title="🌟 MTF+极端超买(降级)", style=shape.labeldown, location=location.top, color=color.new(#FF5252, 70), size=size.tiny, text="🌟", textcolor=color.new(color.white, 50))
plotshape(soft_degraded_sell_div, title="💎 背离+极端超买(降级)", style=shape.labeldown, location=location.top, color=color.new(#FF9800, 70), size=size.tiny, text="💎", textcolor=color.new(color.white, 50))
plotshape(soft_degraded_sell_ext, title="❄️ 极端超买(降级)", style=shape.triangledown, location=location.top, color=color.new(color_bear, 70), size=size.tiny, text="❄️")
plotshape(show_normal_signals and soft_degraded_sell_norm, title="⬇️ 普通超买(降级)", style=shape.circle, location=location.top, color=color.new(color_bear, 80), size=size.tiny, text="⬇️")

// 纯背离信号
plotshape(sig_div_bull_only, title="↗️ 看涨背离", style=shape.circle, location=location.bottom, color=#00BCD4, size=size.tiny, text="↗️")
plotshape(sig_div_bear_only, title="↘️ 看跌背离", style=shape.circle, location=location.top, color=#FF9800, size=size.tiny, text="↘️")

// 双层背景：普通区域(浅) + 极端区域(深)
bgcolor(rsi_zscore < -normal_threshold ? color.new(color_bull, 93) : rsi_zscore > normal_threshold ? color.new(color_bear, 93) : na, title="Normal Zone")
bgcolor(rsi_zscore < -2 ? color.new(color_bull, 85) : rsi_zscore > 2 ? color.new(color_bear, 85) : na, title="Extreme Zone")

// ────────────────────────────────────────
// 通用信号显示逻辑（Mobile/Full 共用）
// ────────────────────────────────────────

// 先选唯一显示事件（强度优先），再由该事件推导方向、等级、隐藏原因与统计桶。
// 不能从“任意买/卖状态”聚合方向，否则同 K 线的反向高等级事件会与等级/Stats Filter 错配。
// Select one display event first (strength priority), then derive direction, grade, hidden reason and stats bucket from it.
// Never infer direction from aggregate buy/sell state: opposite events on one bar could mismatch the label and filter bucket.
int signal_event_kind = switch
    sig_buy_mtf or sig_sell_mtf => 1
    sig_buy_div or sig_sell_div => 2
    sig_buy_extreme or extreme_buy_hidden or sig_sell_extreme or extreme_sell_hidden => 3
    sig_buy_normal or normal_buy_hidden or sig_sell_normal or normal_sell_hidden => 4
    sig_div_bull_only or sig_div_bear_only => 5
    => 0

int signal_event_direction = switch
    signal_event_kind == 1 => sig_buy_mtf ? 1 : -1
    signal_event_kind == 2 => sig_buy_div ? 1 : -1
    signal_event_kind == 3 => sig_buy_extreme or extreme_buy_hidden ? 1 : -1
    signal_event_kind == 4 => sig_buy_normal or normal_buy_hidden ? 1 : -1
    signal_event_kind == 5 => sig_div_bull_only ? 1 : -1
    => 0

bool signal_event_active = signal_event_kind > 0

// 图标后直接写类型/方向，用户无需先查图例。
// Spell out type/direction after the icon so the row is self-explanatory.
string signal_type_text = signal_event_kind >= 1 and signal_event_kind <= 4 ? str.format("{0} {1} {2}", f_signal_kind_icon(signal_event_kind - 1, signal_event_direction == 1), f_signal_kind_name(signal_event_kind - 1), signal_event_direction == 1 ? "BUY" : "SELL") : signal_event_kind == 5 ? (signal_event_direction == 1 ? "↗️ BULL DIV" : "↘️ BEAR DIV") : "—"

// 信号评级
signal_grade_text = signal_event_active ? (signal_event_direction == 1 ? buy_quality_grade : sell_quality_grade) : ""

// 只检查“被选中的事件”是否隐藏；纯背离不会因同方向区域暂停而被误标。
// Check hiding only for the selected event; a pure divergence cannot inherit a paused zone's hidden state.
signal_event_stats_hidden = stats_filter_mode == "Hard" and (signal_event_kind == 1 ? (signal_event_direction == 1 ? sig_buy_mtf and not filter_buy_mtf : sig_sell_mtf and not filter_sell_mtf) : signal_event_kind == 2 ? (signal_event_direction == 1 ? sig_buy_div and not filter_buy_div : sig_sell_div and not filter_sell_div) : signal_event_kind == 3 ? (signal_event_direction == 1 ? sig_buy_extreme and not filter_buy_ext : sig_sell_extreme and not filter_sell_ext) : signal_event_kind == 4 ? (signal_event_direction == 1 ? sig_buy_normal and not filter_buy_norm : sig_sell_normal and not filter_sell_norm) : false)
signal_event_trend_hidden = signal_event_kind == 3 and (signal_event_direction == 1 ? extreme_buy_hidden : extreme_sell_hidden)
signal_event_normal_hidden = signal_event_kind == 4 and (signal_event_direction == 1 ? normal_buy_hidden : normal_sell_hidden)
signal_event_data_hidden = signal_event_kind >= 1 and signal_event_kind <= 4 and not signal_data_ready
signal_event_conflict = signal_event_kind >= 1 and signal_event_kind <= 4 and production_signal_conflict
current_is_hidden = signal_event_active and (signal_event_stats_hidden or signal_event_trend_hidden or signal_event_normal_hidden or signal_event_data_hidden or signal_event_conflict)

signal_event_filter_pass = signal_event_kind == 1 ? (signal_event_direction == 1 ? filter_buy_mtf : filter_sell_mtf) : signal_event_kind == 2 ? (signal_event_direction == 1 ? filter_buy_div : filter_sell_div) : signal_event_kind == 3 ? (signal_event_direction == 1 ? filter_buy_ext : filter_sell_ext) : signal_event_kind == 4 ? (signal_event_direction == 1 ? filter_buy_norm : filter_sell_norm) : true
signal_event_stats = signal_event_direction == 1 ? (signal_event_kind == 1 ? buy_mtf_stats : signal_event_kind == 2 ? buy_div_stats : signal_event_kind == 3 ? buy_ext_stats : buy_norm_stats) : (signal_event_kind == 1 ? sell_mtf_stats : signal_event_kind == 2 ? sell_div_stats : signal_event_kind == 3 ? sell_ext_stats : sell_norm_stats)
signal_event_stats_target = signal_event_direction == 1 ? (signal_event_kind == 1 ? buy_mtf_stats_target : signal_event_kind == 2 ? buy_div_stats_target : signal_event_kind == 3 ? buy_ext_stats_target : buy_norm_stats_target) : (signal_event_kind == 1 ? sell_mtf_stats_target : signal_event_kind == 2 ? sell_div_stats_target : signal_event_kind == 3 ? sell_ext_stats_target : sell_norm_stats_target)
signal_event_insufficient = signal_event_kind >= 1 and signal_event_kind <= 4 and f_stats_insufficient(signal_event_stats, signal_event_stats_target)

// 信号结果：✓/✗ 只表示门槛结果，⏳ 只表示样本不足，⚠️ 保留给运行/数据警告；隐藏原因直接写明。
// Signal result: ✓/✗ are gate verdicts, ⏳ means insufficient samples, and ⚠️ remains a general runtime/data warning; hidden reasons are explicit.
signal_hidden_text = signal_event_data_hidden ? "🚫 DATA" : signal_event_conflict ? "🚫 CONFLICT" : signal_event_trend_hidden ? "🚫 TREND" : signal_event_stats_hidden ? "🚫 STATS" : signal_event_normal_hidden ? (normal_signal_mode == "Off" ? "🚫 OFF" : "🚫 SMART") : "🚫"
signal_mark_text = current_is_hidden ? signal_hidden_text : signal_event_kind >= 1 and signal_event_kind <= 4 and enable_stats and enable_stats_filter ? (signal_event_insufficient ? "⏳" : signal_event_filter_pass ? "✓" : "✗") : ""

// 完整信号显示文本
signal_full_display = signal_event_active ? signal_type_text + (signal_grade_text != "" ? " [Score " + signal_grade_text + "]" : "") + (signal_mark_text != "" ? " " + signal_mark_text : "") : "—"
signal_full_panel_display = signal_event_active ? signal_type_text + (signal_grade_text != "" or signal_mark_text != "" ? "\n" + (signal_grade_text != "" ? "[Score " + signal_grade_text + "]" : "") + (signal_mark_text != "" ? (signal_grade_text != "" ? " " : "") + signal_mark_text : "") : "") : "—"

// 信号颜色
signal_has_gate_verdict = signal_event_kind >= 1 and signal_event_kind <= 4 and enable_stats and enable_stats_filter
signal_full_color = current_is_hidden ? color.new(color.gray, 40) : signal_has_gate_verdict ? (signal_event_insufficient ? #FFC107 : signal_event_filter_pass ? #4CAF50 : #FF9800) : signal_event_direction == 1 ? color_bull : signal_event_direction == -1 ? color_bear : color.gray

// 状态文本（统一使用 normal_threshold）
status_text_full = not chart_data_ready ? "NA · RSI warmup" : rsi_zscore < -2 ? "🟢 EXTREME OVERSOLD" : rsi_zscore < -normal_threshold ? "🟡 OVERSOLD" : rsi_zscore > 2 ? "🔴 EXTREME OVERBOUGHT" : rsi_zscore > normal_threshold ? "🟠 OVERBOUGHT" : "⚪ NEUTRAL"

status_text_mobile = not signal_data_ready ? "⚠️ DATA · " + signal_data_reason : rsi_zscore < -2 ? "🟢极卖" : rsi_zscore < -normal_threshold ? "🟡超卖" : rsi_zscore > 2 ? "🔴极买" : rsi_zscore > normal_threshold ? "🟠超买" : "⚪中性"

status_display_color = rsi_zscore < -normal_threshold ? color_bull : rsi_zscore > normal_threshold ? color_bear : color.gray

// ────────────────────────────────────────
// DASHBOARD
// ────────────────────────────────────────

f_status_text(_status, _available) =>
    not _available ? "No data" : _status == 1 ? "🟢Oversold" : _status == -1 ? "🔴Overbought" : "⚪Neutral"

// Stats Filter 只解释当前已选事件，不根据持续区域猜测未来信号类型。
// 1=MTF 2=Div 3=Ext 4=Norm；0=无可门控事件（含纯背离，它不经过统计门槛）。
// Stats Filter explains only the selected current event; it never guesses a future signal type from a persistent zone.
// 1=MTF 2=Div 3=Ext 4=Norm; 0 = no gateable event (including pure divergence, which bypasses the stats gate).
f_gate_signal_kind() =>
    signal_event_kind >= 1 and signal_event_kind <= 4 ? signal_event_kind : 0

// Gate 桶标签按 Stats Mode 拼装；类型、方向和等级分别写明，避免方向性 emoji 互相矛盾。
// Gate bucket label by Stats Mode; type, direction and grade are explicit so directional emoji never conflict.
f_gate_bucket_label(_kind, _grade, _is_buy) =>
    _signal_idx = _kind - 1
    _dir_text = _is_buy ? "BUY" : "SELL"
    _type_text = f_signal_kind_icon(_signal_idx, _is_buy) + " " + f_signal_kind_name(_signal_idx)
    stats_mode == "Signal Type" ? _type_text + " " + _dir_text : stats_mode == "Grade" ? _dir_text + " [Score " + _grade + "]" : _type_text + " " + _dir_text + " [Score " + _grade + "]"

f_gate_type_bucket_label(_kind, _is_buy) =>
    _signal_idx = _kind - 1
    f_signal_kind_icon(_signal_idx, _is_buy) + " " + f_signal_kind_name(_signal_idx) + " " + (_is_buy ? "BUY" : "SELL")
// @harness: gate-helper

// One action planner drives order placement and its explanation. Closing an
// existing position never depends on whether fresh entry evidence is available.
// 订单与说明共用同一个动作选择器；平仓不依赖新的入场证据是否已准备好。
f_harness_action(int _entry_dir, int _exit_dir, int _position_dir, bool _allow_long, bool _allow_short, bool _entry_ready, bool _date_exit, bool _time_exit) =>
    if _position_dir != 0 and _date_exit
        "Evaluation End"
    else if _position_dir != 0 and _time_exit
        "Time Exit"
    else if _entry_ready and _entry_dir == 1 and _allow_long and _position_dir <= 0
        "Long"
    else if _entry_ready and _entry_dir == -1 and _allow_short and _position_dir >= 0
        "Short"
    else if _position_dir > 0 and _exit_dir == -1
        "Close Long"
    else if _position_dir < 0 and _exit_dir == 1
        "Close Short"
    else
        "Idle"

raw_strategy_buy_signal = sig_buy_mtf or sig_buy_div or sig_buy_extreme or (show_normal_signals and sig_buy_normal)
raw_strategy_sell_signal = sig_sell_mtf or sig_sell_div or sig_sell_extreme or (show_normal_signals and sig_sell_normal)
production_strategy_buy_signal = alert_buy_mtf or alert_buy_div or alert_buy_ext or (show_normal_signals and alert_buy_norm)
production_strategy_sell_signal = alert_sell_mtf or alert_sell_div or alert_sell_ext or (show_normal_signals and alert_sell_norm)
strategy_buy_signal = harness_use_production ? production_strategy_buy_signal : raw_strategy_buy_signal
strategy_sell_signal = harness_use_production ? production_strategy_sell_signal : raw_strategy_sell_signal
strategy_signal_dir = strategy_buy_signal and not strategy_sell_signal ? 1 : strategy_sell_signal and not strategy_buy_signal ? -1 : 0

// This stream closes existing positions only. Entry candidates above retain all
// production protections; exit candidates do not inherit entry trend/data gates,
// sampling cooldown or weekly Smart hiding. Explicit user signal options remain.
// 此流仅用于已有持仓的退出；上方入场候选仍保留生产保护。退出不继承入场趋势/数据
// 门槛、采样冷却或周线Smart隐藏，但继续遵守显式百分位及普通信号Off设置。
harness_exit_buy_mtf = enable_mtf and oversold_resonance and raw_extreme_oversold and pct_allows_buy
harness_exit_buy_div = enable_divergence and bullish_divergence and was_extreme_oversold and not harness_exit_buy_mtf
harness_exit_buy_ext = raw_extreme_oversold and pct_allows_buy and not harness_exit_buy_mtf and not harness_exit_buy_div
harness_exit_buy_norm = normal_signal_mode != "Off" and raw_normal_oversold and not harness_exit_buy_mtf and not harness_exit_buy_div and not harness_exit_buy_ext
harness_exit_sell_mtf = enable_mtf and overbought_resonance and raw_extreme_overbought and pct_allows_sell
harness_exit_sell_div = enable_divergence and bearish_divergence and was_extreme_overbought and not harness_exit_sell_mtf
harness_exit_sell_ext = raw_extreme_overbought and pct_allows_sell and not harness_exit_sell_mtf and not harness_exit_sell_div
harness_exit_sell_norm = normal_signal_mode != "Off" and raw_normal_overbought and not harness_exit_sell_mtf and not harness_exit_sell_div and not harness_exit_sell_ext
harness_raw_exit_buy_signal = harness_exit_buy_mtf or harness_exit_buy_div or harness_exit_buy_ext or harness_exit_buy_norm
harness_raw_exit_sell_signal = harness_exit_sell_mtf or harness_exit_sell_div or harness_exit_sell_ext or harness_exit_sell_norm
harness_raw_exit_signal_dir = harness_raw_exit_buy_signal and not harness_raw_exit_sell_signal ? 1 : harness_raw_exit_sell_signal and not harness_raw_exit_buy_signal ? -1 : 0
harness_exit_signal_dir = harness_exit_signal_policy == "Raw" ? harness_raw_exit_signal_dir : strategy_signal_dir
allow_long_entries = harness_trade_side == "Long Only" or harness_trade_side == "Both"
allow_short_entries = harness_trade_side == "Short Only" or harness_trade_side == "Both"
harness_position_dir = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
harness_entry_ready = barstate.isconfirmed and signal_data_ready and harness_in_evaluation
harness_time_exit_due = harness_max_holding_bars > 0 and strategy.opentrades > 0 and bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) >= harness_max_holding_bars - 1
harness_action = f_harness_action(strategy_signal_dir, harness_exit_signal_dir, harness_position_dir, allow_long_entries, allow_short_entries, harness_entry_ready, harness_evaluation_ended, harness_time_exit_due)
harness_raw_exit = harness_exit_signal_policy == "Raw" and (harness_action == "Close Long" or harness_action == "Close Short")
harness_forced_exit = harness_action == "Evaluation End" or harness_action == "Time Exit"
harness_evaluation_state = not harness_dates_valid ? "INVALID DATES" : harness_training ? "TRAINING" : harness_evaluation_ended ? (strategy.position_size != 0 ? "ENDING · EXIT PENDING" : "ENDED") : not signal_data_ready ? "WARMUP · DATA" : harness_use_date_range ? "EVALUATION" : "ALL LOADED HISTORY"

f_harness_order_message(string _event, string _direction) =>
    str.format("ARSI_STRATEGY|v=7.7|event={0}|symbol={1}|tf={2}|order_bar={3}|order_time={4}|direction={5}|reference_close={6}|mode={7}|exit_policy={8}", _event, syminfo.tickerid, timeframe.period, bar_index, time_close, _direction, close, harness_backtest_mode, harness_exit_signal_policy)

// Raw Baseline ignores the production stats gate. Keep its requested bucket and
// target, but omit pass/fail marks so descriptive evidence cannot look like a rule.
// Edge estimates use one metric per line to keep the right cell narrow.
// Raw Baseline 不执行生产统计门槛；保留请求桶及其目标，但不显示质量勾叉。
// Edge 估计每项独占一行，避免右侧单元格横向过长。
f_harness_raw_stats_readout(SignalStats _stats, bool _is_buy, int _target) =>
    _lifetime_n = _stats.get_lifetime_count()
    if _lifetime_n < 5
        "RAW · GATE IGNORED\nNo usable estimate"
    else
        [_has_enough, _edge_mode, _payoff_active, _wr_pass, _payoff_pass, _quality_ok, _adj_wr, _payoff_edge] = f_stats_gate_paths(_stats, _is_buy, _target)
        if _edge_mode
            _wr_edge = _adj_wr - f_stats_baseline_rate(_is_buy)
            str.format("RAW · GATE IGNORED\nWR edge {0,number,+#.2;-#.2}pp\nAvg edge {1,number,+#.2;-#.2}%", _wr_edge, _payoff_edge)
        else
            str.format("RAW · GATE IGNORED\nWR {0,number,#.2}% · no gate", _adj_wr)

f_harness_gate_snapshot() =>
    string _source = "Idle"
    string _sample_display = ""
    string _readout = "No strategy signal"
    color _readout_color = color.gray
    SignalStats _stats = SignalStats.new()
    int _target = stats_min_samples

    // Rebuild the exact strategy signal for this backtest mode. Trade Side changes
    // whether the signal enters, exits or reverses; it must not rewrite its direction.
    // 按当前回测模式重建实际策略信号。Trade Side 只改变该信号是入场、
    // 平仓还是反手，不能篡改信号方向。
    bool _read_raw = not harness_use_production
    bool _buy_mtf = harness_raw_exit ? harness_exit_buy_mtf : _read_raw ? sig_buy_mtf : alert_buy_mtf
    bool _buy_div = harness_raw_exit ? harness_exit_buy_div : _read_raw ? sig_buy_div : alert_buy_div
    bool _buy_ext = harness_raw_exit ? harness_exit_buy_ext : _read_raw ? sig_buy_extreme : alert_buy_ext
    bool _buy_norm = harness_raw_exit ? harness_exit_buy_norm : _read_raw ? show_normal_signals and sig_buy_normal : show_normal_signals and alert_buy_norm
    bool _sell_mtf = harness_raw_exit ? harness_exit_sell_mtf : _read_raw ? sig_sell_mtf : alert_sell_mtf
    bool _sell_div = harness_raw_exit ? harness_exit_sell_div : _read_raw ? sig_sell_div : alert_sell_div
    bool _sell_ext = harness_raw_exit ? harness_exit_sell_ext : _read_raw ? sig_sell_extreme : alert_sell_ext
    bool _sell_norm = harness_raw_exit ? harness_exit_sell_norm : _read_raw ? show_normal_signals and sig_sell_normal : show_normal_signals and alert_sell_norm
    bool _has_buy = _buy_mtf or _buy_div or _buy_ext or _buy_norm
    bool _has_sell = _sell_mtf or _sell_div or _sell_ext or _sell_norm
    int _direction = harness_forced_exit ? 0 : _has_buy and not _has_sell ? 1 : _has_sell and not _has_buy ? -1 : 0
    bool _use_buy = _direction == 1
    bool _use_mtf = false
    bool _use_div = false
    bool _use_ext = false
    string _grade = "D"

    if _has_buy and _has_sell
        _source := "Conflict"

    if _direction == 1
        _grade := buy_quality_grade
        if _buy_mtf
            _use_mtf := true
        else if _buy_div
            _use_div := true
        else if _buy_ext
            _use_ext := true
    else if _direction == -1
        _grade := sell_quality_grade
        if _sell_mtf
            _use_mtf := true
        else if _sell_div
            _use_div := true
        else if _sell_ext
            _use_ext := true

    if _direction != 0
        // Production must explain the exact evidence bucket used by its active gate.
        // Raw Baseline (and a disabled production filter) keeps the requested bucket.
        // Production 必须解释启用中 gate 实际使用的证据桶；Raw Baseline（以及关闭的
        // Production filter）保留用户请求桶，不借用父级统计。
        bool _use_resolved = harness_use_production and not harness_raw_exit and enable_stats and enable_stats_filter
        string _evidence_source = ""
        if _use_resolved
            _stats := f_get_filter_stats(_use_buy, _use_mtf, _use_div, _use_ext, _grade)
            _target := f_get_filter_target(_use_buy, _use_mtf, _use_div, _use_ext, _grade)
            _evidence_source := f_get_filter_source(_use_buy, _use_mtf, _use_div, _use_ext, _grade)
        else
            _stats := f_harness_get_requested_stats(_use_buy, _use_mtf, _use_div, _use_ext, _grade)
            _target := f_harness_get_requested_target(_use_buy, _use_mtf, _use_div, _use_ext, _grade)
        _source := f_get_filter_source_label(_use_mtf, _use_div, _use_ext, _grade, _use_buy, _evidence_source)
        _sample_display := not enable_stats ? "Stats off" : f_stats_sample_text(_stats, _target)
        _readout := not enable_stats or (harness_use_production and not harness_raw_exit) ? f_stats_direct_readout(_stats, _use_buy, _target) : f_harness_raw_stats_readout(_stats, _use_buy, _target)
        _readout_color := harness_use_production and not harness_raw_exit ? f_stats_direct_color(_stats, _use_buy, _target) : color.gray
        if harness_raw_exit
            _readout := not enable_stats ? "RAW EXIT · GATE IGNORED\nStats off" : str.replace_all(_readout, "RAW · GATE IGNORED", "RAW EXIT · GATE IGNORED")

    if harness_forced_exit
        _source := "Exit"
        _sample_display := "Entry gate ignored"
        _readout := str.format("CLOSE {0}\n{1}", strategy.position_size > 0 ? "LONG" : "SHORT", harness_action)
        _readout_color := color.white
    else if not signal_data_ready and not harness_raw_exit
        _source := "Data"
        _sample_display := "Entry data unavailable"
        _readout := harness_use_production ? "BLOCK · DATA\nNo new entry" : "RAW · DATA WAIT\nNo new entry"
        _readout_color := color.yellow

    [_source, _sample_display, _readout, _readout_color]

if show_dashboard
    // 经验分位只能定位到区间，不能把区间上界冒充精确百分位（例如 P50–P75 不能写成 P75）。
    // Empirical rank is interval-valued; never present the interval ceiling as an exact percentile.
    hist_rank_text = na(rsi_p5) or na(rsi_p10) or na(rsi_p25) or na(rsi_p50) or na(rsi_p75) or na(rsi_p90) or na(rsi_p95) ? "NA · need history" :
                     rsi <= rsi_p5 ? "≤P5" :
                     rsi <= rsi_p10 ? "P5–P10" :
                     rsi <= rsi_p25 ? "P10–P25" :
                     rsi <= rsi_p50 ? "P25–P50" :
                     rsi <= rsi_p75 ? "P50–P75" :
                     rsi <= rsi_p90 ? "P75–P90" :
                     rsi <= rsi_p95 ? "P90–P95" : ">P95"

    txt_size_title = dashboard_size == "Tiny" ? size.tiny : dashboard_size == "Small" ? size.small : dashboard_size == "Normal" ? size.normal : size.large
    txt_size_body = dashboard_size == "Tiny" ? size.tiny : dashboard_size == "Small" ? size.tiny : dashboard_size == "Normal" ? size.small : size.normal

    div_text = bullish_divergence ? "Bullish" : bearish_divergence ? "Bearish" : "None"
    div_color = bullish_divergence ? #00BCD4 : bearish_divergence ? #FF9800 : color.gray

    resonance_base = oversold_resonance ? str.format("Oversold resonance · {0}/{1} incl chart", oversold_count, valid_tf_count) :
                     overbought_resonance ? str.format("Overbought resonance · {0}/{1} incl chart", overbought_count, valid_tf_count) :
                     str.format("No resonance · {0}/{1} incl chart", math.max(oversold_count, overbought_count), valid_tf_count)
    // 各周期状态自身用 No data 标明缺失，避免在共振说明中重复同一警告。
    // Each timeframe marks missing data directly, so the resonance summary does not repeat the same warning.
    resonance_text = not mtf_context_ready ? "Unavailable · coverage / warmup" : valid_tf_count < 2 ? "Need a distinct timeframe" : resonance_base
    resonance_color = oversold_resonance ? color_bull : overbought_resonance ? color_bear : color.gray

    mobile_rows = 3
    // 基础 7 行；MTF 状态与共振合并为 1 行；方向优势摘要最多 1 行；Stats Filter 仅在当前事件时渲染，但保留 1 行容量。
    // Seven base rows; MTF state/resonance share one row; edge summary is at most one row; reserve one filter row although it renders only for a current event.
    full_rows = 12 + (enable_mtf ? 1 : 0) + (enable_divergence ? 1 : 0) + (enable_stats ? 9 : 0) + (enable_stats and stats_gate_mode == "Edge vs Baseline" ? 1 : 0) + (enable_stats and enable_stats_filter ? 1 : 0)
    total_rows = dashboard_mode == "Mobile" ? mobile_rows : full_rows

    var table dashboard = table.new(position.top_right, 2, 26,
                                     bgcolor=color.new(#1a1a2e, dashboard_transparency),
                                     border_width=1, border_color=color.new(#4a4a6a, 50))

    if barstate.islastconfirmedhistory or barstate.isrealtime
        table.clear(dashboard, 0, 0, 1, 25)
        row = 0

        if dashboard_mode == "Mobile"
            // Row 1: RSI
            table.cell(dashboard, 0, row, "RSI", text_color=color.gray, text_size=txt_size_body, bgcolor=color.new(#2962FF, dashboard_transparency))
            table.cell(dashboard, 1, row, str.tostring(rsi, "#.1"), text_color=color_rsi, text_size=txt_size_body, bgcolor=color.new(#2962FF, dashboard_transparency))
            row += 1

            // Row 2: Signal（使用通用变量）
            table.cell(dashboard, 0, row, "Signal", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, signal_full_display, text_color=signal_full_color, text_size=txt_size_body)
            row += 1

            // Row 3: RSI Zone（区域状态，与当前 K 线 Signal 事件分离）
            table.cell(dashboard, 0, row, "RSI Zone", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, status_text_mobile, text_color=status_display_color, text_size=txt_size_body)
            row += 1

        else
            table.cell(dashboard, 0, row, "ADAPTIVE RSI", text_color=color.white, text_size=txt_size_title, bgcolor=color.new(#2962FF, dashboard_transparency))
            table.cell(dashboard, 1, row, str.tostring(rsi, "#.0"), text_color=color_rsi, text_size=txt_size_title, bgcolor=color.new(#2962FF, dashboard_transparency))
            row += 1

            position_display = str.format("Z {0,number,+#.2;-#.2}σ\nHistory {1}", rsi_zscore, hist_rank_text)
            table.cell(dashboard, 0, row, "RSI Position", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, position_display, text_color=status_display_color, text_size=txt_size_body)
            row += 1

            // Signal 行（使用通用变量，与 Mobile 一致）
            table.cell(dashboard, 0, row, "Signal", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, signal_full_panel_display, text_color=signal_full_color, text_size=txt_size_body)
            row += 1

            // RSI Zone 行（持续区域只在这里显示，不与 Signal 重复）
            table.cell(dashboard, 0, row, "RSI Zone", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, status_text_full, text_color=status_display_color, text_size=txt_size_body)
            row += 1

            data_start = na(evidence_start_time) ? "No eligible history" : "Eligible since " + str.format_time(evidence_start_time, "yyyy-MM-dd", syminfo.timezone)
            table.cell(dashboard, 0, row, "Data Context", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, signal_data_reason + "\n" + data_start, text_color=signal_data_ready ? color.white : color.yellow, text_size=txt_size_body)
            row += 1

            // Stats Filter 只在当前事件存在时渲染；无事件时不占一行，也不猜测未来信号类型。
            // 样本状态、质量路径和最终动作分别写明；桶选择与总判定复用生产过滤结果，避免显示与实际 gate 漂移。
            // Render Stats Filter only for a current event; omit it otherwise and never guess a future signal type.
            // Sample state, quality paths and final action are explicit; bucket selection/verdict reuse production outputs so display cannot drift from the gate.
            if enable_stats and enable_stats_filter
                gate_kind = f_gate_signal_kind()
                gate_row_visible = signal_event_active
                gate_is_buy = signal_event_direction == 1
                gate_grade = gate_is_buy ? buy_quality_grade : sell_quality_grade
                if gate_row_visible
                    string gate_left_display = "Stats Filter\nPure divergence"
                    string gate_display = "DISPLAY ONLY\nNot an alert signal"
                    color gate_color = color.gray
                    if gate_kind > 0
                        gate_stats = gate_is_buy ? (gate_kind == 1 ? buy_mtf_stats : gate_kind == 2 ? buy_div_stats : gate_kind == 3 ? buy_ext_stats : buy_norm_stats) : (gate_kind == 1 ? sell_mtf_stats : gate_kind == 2 ? sell_div_stats : gate_kind == 3 ? sell_ext_stats : sell_norm_stats)
                        gate_target = gate_is_buy ? (gate_kind == 1 ? buy_mtf_stats_target : gate_kind == 2 ? buy_div_stats_target : gate_kind == 3 ? buy_ext_stats_target : buy_norm_stats_target) : (gate_kind == 1 ? sell_mtf_stats_target : gate_kind == 2 ? sell_div_stats_target : gate_kind == 3 ? sell_ext_stats_target : sell_norm_stats_target)
                        gate_source = gate_is_buy ? (gate_kind == 1 ? buy_mtf_stats_source : gate_kind == 2 ? buy_div_stats_source : gate_kind == 3 ? buy_ext_stats_source : buy_norm_stats_source) : (gate_kind == 1 ? sell_mtf_stats_source : gate_kind == 2 ? sell_div_stats_source : gate_kind == 3 ? sell_ext_stats_source : sell_norm_stats_source)
                        gate_title = "Stats Filter"
                        gate_label = gate_source == "Type fallback" ? f_gate_type_bucket_label(gate_kind, gate_is_buy) + " → Type" : f_gate_bucket_label(gate_kind, gate_grade, gate_is_buy)
                        gate_left_display := gate_title + "\n" + gate_label + "\n" + f_stats_sample_text(gate_stats, gate_target)
                        gate_display := f_stats_direct_readout(gate_stats, gate_is_buy, gate_target)
                        gate_color := f_stats_direct_color(gate_stats, gate_is_buy, gate_target)
                        if not signal_data_ready
                            gate_display := "BLOCK · DATA\n" + signal_data_reason
                            gate_color := color.yellow
                        else if production_signal_conflict
                            gate_display := "BLOCK · CONFLICT\nBUY + SELL · No alert"
                            gate_color := color.yellow
                    table.cell(dashboard, 0, row, gate_left_display, text_color=color.gray, text_size=txt_size_body)
                    table.cell(dashboard, 1, row, gate_display, text_color=gate_color, text_size=txt_size_body)
                    row += 1

            // @harness: dashboard-rows
            harness_side_display = harness_trade_side == "Long Only" ? "Long only" : harness_trade_side == "Short Only" ? "Short only" : "Long + short"
            harness_mode_display = harness_use_production ? "Production filter" : "Raw baseline"
            harness_tester_display = harness_trade_side == "Long Only" ? "All = long trades" : harness_trade_side == "Short Only" ? "All = short trades" : "All = both sides"
            harness_risk_display = str.format("ATR {0} · Time {1}", harness_use_risk_exits ? "on" : "off", harness_max_holding_bars > 0 ? str.tostring(harness_max_holding_bars) + " bars" : "off")
            [harness_gate_source, harness_gate_sample_display, harness_gate_readout, harness_gate_color] = f_harness_gate_snapshot()
            // Strategy Stats 解释本回测模式的实际买/卖信号：Production 复用真实 gate 结论，Raw Baseline 明确忽略 gate。
            // Strategy Stats explains the actual signal in this backtest mode: Production reuses the real gate verdict; Raw Baseline explicitly ignores it.
            harness_stats_left = harness_gate_source == "Idle" or harness_gate_source == "Conflict" ? "Strategy Stats" : str.format("Strategy Stats\n{0}\n{1}", harness_gate_source, harness_gate_sample_display)
            harness_gate_display = harness_gate_source == "Idle" ? "No strategy signal" : harness_gate_source == "Conflict" ? "BUY + SELL conflict\nNo strategy action" : harness_gate_readout

            table.cell(dashboard, 0, row, "Backtest", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, str.format("{0} · {1}\nExit signals: {2}\n{3}", harness_side_display, harness_mode_display, harness_exit_signal_policy, harness_risk_display), text_color=color.white, text_size=txt_size_body)
            row += 1

            table.cell(dashboard, 0, row, "Tester View", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, harness_tester_display + "\nSignal close → next open", text_color=color.white, text_size=txt_size_body)
            row += 1

            table.cell(dashboard, 0, row, harness_stats_left, text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, harness_gate_display, text_color=harness_gate_color, text_size=txt_size_body)
            row += 1

            // TradingView's completed-trade metrics already include configured
            // commissions; never subtract fees a second time. Open P&L remains
            // visible and is excluded from the closed-trade win-rate denominator.
            // 已平仓指标已含配置佣金，不能再次扣费；未平仓盈亏另列，不充当胜率样本。
            harness_closed_n = strategy.closedtrades
            harness_wr_text = harness_closed_n > 0 ? str.format("{0,number,#.1}%", strategy.wintrades * 100.0 / harness_closed_n) : "—"
            harness_pf_text = strategy.grossloss > 0 ? str.format("{0,number,#.2}", strategy.grossprofit / strategy.grossloss) : strategy.grossprofit > 0 ? "∞" : "—"
            harness_avg_text = harness_closed_n > 0 ? str.format("{0,number,+#.2;-#.2}", strategy.netprofit / harness_closed_n) : "—"
            harness_open_bars = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) + 1 : 0
            harness_result_text = str.format("WR {0} · {1} closed\nPF {2} · Avg {3} {4}\nOpen {5,number,+#.2;-#.2} {4} · {6} bars", harness_wr_text, harness_closed_n, harness_pf_text, harness_avg_text, strategy.account_currency, strategy.openprofit, harness_open_bars)
            table.cell(dashboard, 0, row, "Trade Results\nSIMULATED · NET\n" + harness_evaluation_state, text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, harness_result_text, text_color=color.white, text_size=txt_size_body)
            row += 1

            weekly_rsi_display = na(weekly_rsi) ? "W-RSI --" : str.format("W-RSI {0,number,#}", weekly_rsi)
            trend_context = not weekly_data_ready ? "Weekly context unavailable" : not enable_trend_protection ? "Trend: Off" : trend_allows_buy and trend_allows_sell ? str.format("Trend {0}: Both allowed", protection_level) : trend_allows_buy ? str.format("Trend {0}: BUY only", protection_level) : trend_allows_sell ? str.format("Trend {0}: SELL only", protection_level) : str.format("Trend {0}: Both blocked", protection_level)
            volume_context = not enable_volume_scoring ? "Volume: score off" : volume_surge ? str.format("Volume: Surge ({0,number,#.1}×)", volume_ratio) : volume_low ? str.format("Volume: Low ({0,number,#.1}×)", volume_ratio) : str.format("Volume: Normal ({0,number,#.1}×)", volume_ratio)
            context_color = not weekly_data_ready ? color.yellow : not enable_trend_protection or trend_allows_buy and trend_allows_sell ? color.white : trend_allows_buy or trend_allows_sell ? color.yellow : color.red
            table.cell(dashboard, 0, row, "Market Context", text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, trend_context + "\n" + weekly_rsi_display + "\n" + volume_context, text_color=context_color, text_size=txt_size_body)
            row += 1

            lookback_mode_display = lookback_mode == "Auto" ? "[Auto]" : "[Custom]"
            lookback_healthy = health_sample_coverage and health_distribution_spread and health_stat_valid
            health_issue_line1 = not health_sample_coverage ? "Need more chart history" : not health_distribution_spread ? "RSI range too narrow" : not health_stat_valid ? "Lookback below statistical minimum" : ""
            health_issue_line2 = not health_sample_coverage and not health_distribution_spread and not health_stat_valid ? "RSI range narrow · lookback below minimum" : not health_sample_coverage and not health_distribution_spread ? "RSI range too narrow" : not health_sample_coverage and not health_stat_valid ? "Lookback below statistical minimum" : not health_distribution_spread and not health_stat_valid ? "Lookback below statistical minimum" : ""
            lookback_left = lookback_mode == "Auto" ? str.format("Lookback {0}\nAllowed {1}–{2} bars", lookback_mode_display, lookback_min, lookback_max) : str.format("Lookback {0}", lookback_mode_display)
            lookback_display = str.format("{0} bars\n", lookback) + (lookback_healthy ? "Healthy" : health_issue_line1 + (health_issue_line2 == "" ? "" : "\n" + health_issue_line2))
            lookback_color = lookback_healthy ? color.white : color.yellow
            table.cell(dashboard, 0, row, lookback_left, text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, lookback_display, text_color=lookback_color, text_size=txt_size_body)
            row += 1

            // Normal Signal 行
            normal_mode_display = normal_signal_mode == "Smart" ? "[Smart]" : normal_signal_mode == "On" ? "[On]" : "[Off]"
            normal_status = normal_signal_mode == "Off" ? "Off" : show_normal_signals ? str.format("Active\nThreshold ±{0,number,#.2}σ", normal_threshold) : str.format("Paused by weekly trend\nThreshold ±{0,number,#.2}σ", normal_threshold)
            normal_color = normal_signal_mode == "Off" ? color.gray : show_normal_signals ? color.white : color.new(color.gray, 50)
            table.cell(dashboard, 0, row, str.format("Normal Signals {0}", normal_mode_display), text_color=color.gray, text_size=txt_size_body)
            table.cell(dashboard, 1, row, normal_status, text_color=normal_color, text_size=txt_size_body)
            row += 1

            if dashboard_mode == "Full"
                if enable_mtf
                    table.cell(dashboard, 0, row, "MTF", text_color=color.gray, text_size=txt_size_body)
                    mtf_states = str.format("{0} {1} · {2} {3}\n{4} {5}", mtf_tf1_display, f_status_text(status_tf1, mtf_data_ok_tf1), mtf_tf2_display, f_status_text(status_tf2, mtf_data_ok_tf2), mtf_tf3_display, f_status_text(status_tf3, mtf_data_ok_tf3))
                    table.cell(dashboard, 1, row, mtf_states + "\n" + resonance_text, text_color=resonance_color, text_size=txt_size_body)
                    row += 1

                if enable_divergence
                    div_mode_display = div_mode == "Auto" ? str.format("Auto / {0}", active_div_mode) : div_mode
                    table.cell(dashboard, 0, row, "Divergence", text_color=color.gray, text_size=txt_size_body)
                    table.cell(dashboard, 1, row, str.format("{0} · {1}\nPivot {2} · Max gap {3} bars", div_text, div_mode_display, div_lookback, div_range), text_color=div_color, text_size=txt_size_body)
                    row += 1

                if enable_stats
                    stats_title = stats_mode == "Ranking" ? (stats_gate_mode == "Edge vs Baseline" ? "── WR-EDGE RANK ──" : "── WIN-RATE RANK ──") : stats_mode == "Grade" ? "── SETUP SCORE STATS ──" : "── SIGNAL STATS ──"
                    // Edge 模式显示方向基准→实际最低胜率；Legacy 是固定绝对门槛，不能伪装成由基准推导。
                    // Edge mode shows direction baseline→effective minimum; Legacy is a fixed absolute threshold and must not imply baseline derivation.
                    stats_logic = stats_payoff_mode == "Either Edge" ? "OR" : stats_payoff_mode == "Both Edges" ? "AND" : "WR only"
                    stats_gate_label = not enable_stats_filter ? "Filter off" : stats_gate_mode == "Edge vs Baseline" ? (stats_payoff_mode == "Off" ? "WR only" : stats_logic) : "Absolute WR"
                    stats_policy_label = stats_sample_policy == "Fixed (Legacy)" ? str.format("Fixed target n {0}", stats_min_samples) : not stats_independent_samples ? str.format("Adaptive guard n {0}", stats_min_samples) : str.format("Adaptive n {0}–{1}", f_stats_adaptive_target_low(), f_stats_adaptive_target_high())
                    stats_title_display = stats_title + str.format("\nOutcome +{0} bars\n{1} · {2}", stats_forward_bars, stats_gate_label, stats_policy_label)
                    stats_header = stats_gate_mode == "Edge vs Baseline" ? (stats_payoff_mode == "Off" ? str.format("BUY WR {0,number,#.2}→{1,number,#.2}%\nSELL WR {2,number,#.2}→{3,number,#.2}%", f_stats_baseline_rate(true), f_stats_required_winrate(true), f_stats_baseline_rate(false), f_stats_required_winrate(false)) : str.format("Avg edge min {0,number,+#.1;-#.1}%\nBUY WR {1,number,#.2}→{2,number,#.2}%\nSELL WR {3,number,#.2}→{4,number,#.2}%", stats_min_payoff_edge, f_stats_baseline_rate(true), f_stats_required_winrate(true), f_stats_baseline_rate(false), f_stats_required_winrate(false))) : str.format("Minimum WR {0,number,#.2}%", stats_min_winrate)
                    table.cell(dashboard, 0, row, stats_title_display, text_color=color.gray, text_size=txt_size_body)
                    table.cell(dashboard, 1, row, stats_header, text_color=color.gray, text_size=txt_size_body)
                    row += 1

                    // 方向优势摘要：只用成熟且仍有有效权重的桶；双方向合并为一行，不推断“趋势市”。
                    // Direction edge summary uses mature buckets with usable effective weight; combine both directions and do not diagnose a regime.
                    if stats_gate_mode == "Edge vs Baseline"
                        no_buy_edge = f_stats_no_timing_edge(true)
                        no_sell_edge = f_stats_no_timing_edge(false)
                        if no_buy_edge or no_sell_edge
                            edge_summary = no_buy_edge and no_sell_edge ? "BUY: no supported edge\nSELL: no supported edge" : no_buy_edge ? "BUY: no supported edge" : "SELL: no supported edge"
                            table.cell(dashboard, 0, row, "Edge Summary", text_color=color.orange, text_size=txt_size_body)
                            table.cell(dashboard, 1, row, edge_summary, text_color=color.orange, text_size=txt_size_body)
                            row += 1

                    if stats_mode == "Signal Type"
                        for sig_idx = 0 to STATS_SIGNAL_COUNT - 1
                            for dir_idx = 0 to STATS_DIR_COUNT - 1
                                is_buy = dir_idx == STATS_DIR_BUY
                                sig_stats = array.get(signal_type_stats, f_signal_type_bucket_index(is_buy, sig_idx))
                                sig_target = f_stats_signal_type_target(is_buy, sig_idx)
                                sig_display = f_stats_direct_readout(sig_stats, is_buy, sig_target)
                                sig_value_color = f_stats_direct_color(sig_stats, is_buy, sig_target)
                                table.cell(dashboard, 0, row, f_signal_type_dashboard_label(sig_idx, is_buy) + "\n" + f_stats_sample_text(sig_stats, sig_target), text_color=f_signal_type_dashboard_color(sig_idx, is_buy, color_bull, color_bear), text_size=txt_size_body)
                                table.cell(dashboard, 1, row, sig_display, text_color=sig_value_color, text_size=txt_size_body)
                                row += 1

                    else if stats_mode == "Grade"
                        for grade_idx = 0 to STATS_GRADE_COUNT - 1
                            for dir_idx = 0 to STATS_DIR_COUNT - 1
                                is_buy = dir_idx == STATS_DIR_BUY
                                grade_label = f_grade_value(grade_idx)
                                grade_bucket = array.get(grade_stats, grade_idx * STATS_DIR_COUNT + dir_idx)
                                grade_target = f_stats_grade_target(is_buy, grade_label)
                                grade_display = f_stats_direct_readout(grade_bucket, is_buy, grade_target)
                                grade_value_color = f_stats_direct_color(grade_bucket, is_buy, grade_target)
                                table.cell(dashboard, 0, row, str.format("{0}\n[Score {1}]\n{2}", is_buy ? "BUY" : "SELL", grade_label, f_stats_sample_text(grade_bucket, grade_target)), text_color=f_grade_dashboard_color(grade_idx), text_size=txt_size_body)
                                table.cell(dashboard, 1, row, grade_display, text_color=grade_value_color, text_size=txt_size_body)
                                row += 1

                    else if stats_mode == "Ranking"
                        var ranking_sort_key = array.new_float(STATS_RANKING_BUCKETS, 0.0)
                        var ranking_has_data = array.new_bool(STATS_RANKING_BUCKETS, false)
                        var ranking_idx = array.new_int(STATS_RANKING_BUCKETS)

                        // Edge 模式排序键 = 调整胜率 - 该桶自身方向的基准胜率（优势）
                        // 调整胜率收缩向各方向不同的基准，直接比较会让排行榜按方向基准而非信号质量排序（与门槛逻辑矛盾）
                        // Legacy 模式保持原排序（按调整胜率）；无数据桶用极小排序键沉底
                        // Edge mode sort key = adjusted win rate - the bucket's own direction baseline (its edge)
                        // Adjusted rates shrink toward per-direction baselines, so comparing them directly ranks by direction baseline instead of signal quality (contradicting the gate)
                        // Legacy mode keeps the original sort (by adjusted win rate); buckets without data sink with a sentinel key
                        for i = 0 to STATS_RANKING_BUCKETS - 1
                            rank_stats = array.get(ranking_stats, i)
                            rank_is_buy = f_ranking_direction_number(i) == 1
                            rank_has_data = rank_stats.get_count() >= 5
                            rank_adj = rank_has_data ? rank_stats.get_adjusted_winrate_vs(f_stats_display_prior(rank_is_buy)) : 0
                            rank_key = not rank_has_data ? -999.0 : stats_gate_mode == "Edge vs Baseline" ? rank_adj - f_stats_baseline_rate(rank_is_buy) : rank_adj
                            array.set(ranking_sort_key, i, rank_key)
                            array.set(ranking_has_data, i, rank_has_data)
                            array.set(ranking_idx, i, i)

                        // 创建索引数组用于排序
                        for i = 0 to STATS_RANKING_BUCKETS - 2
                            for j = 0 to STATS_RANKING_BUCKETS - 2 - i
                                idx_j = array.get(ranking_idx, j)
                                idx_j1 = array.get(ranking_idx, j + 1)
                                if array.get(ranking_sort_key, idx_j) < array.get(ranking_sort_key, idx_j1)
                                    array.set(ranking_idx, j, idx_j1)
                                    array.set(ranking_idx, j + 1, idx_j)

                        display_count = 0
                        for i = 0 to STATS_RANKING_BUCKETS - 1
                            if display_count >= 8
                                break
                            idx = array.get(ranking_idx, i)
                            // 显式有数据判定（有效样本数≥5），不再以胜率符号判断；Edge 模式下负优势桶仍会显示并自然排在最后
                            // Explicit has-data check (effective count >= 5) instead of the win-rate sign; in Edge mode negative-edge buckets are still shown and naturally rank last
                            if array.get(ranking_has_data, idx)
                                rank_stats = array.get(ranking_stats, idx)
                                sig = f_ranking_signal_number(idx)
                                grd = f_grade_value(f_ranking_grade_index(idx))
                                dir = f_ranking_direction_number(idx)
                                is_buy_rank = dir == 1
                                dir_text = is_buy_rank ? "BUY" : "SELL"
                                dir_clr = f_dir_color(dir, color_bull, color_bear)

                                rank_target = f_stats_ranking_target(is_buy_rank, sig - 1, grd)
                                label_text = str.format("{0} {1}\n{2} [Score {3}]\n{4}", f_signal_kind_icon(sig - 1, is_buy_rank), f_signal_kind_name(sig - 1), dir_text, grd, f_stats_sample_text(rank_stats, rank_target))
                                // Adaptive 下未成熟的排行榜行只描述精确桶本身；当前事件可能改用父级桶，不能在这里冒充最终 ALLOW/BLOCK。
                                // Under Adaptive, an unready ranking row describes only its exact bucket; a current event may use its parent, so this is not a final action.
                                exact_has_verdict = f_stats_has_verdict_samples(rank_stats, rank_target)
                                parent_stats = array.get(signal_type_stats, f_signal_type_bucket_index(is_buy_rank, sig - 1))
                                parent_target = f_stats_signal_type_target(is_buy_rank, sig - 1)
                                parent_ready = f_stats_has_verdict_samples(parent_stats, parent_target)
                                parent_progress = f_stats_sample_text(parent_stats, parent_target)
                                value_text = stats_sample_policy == "Adaptive" and not exact_has_verdict ? (parent_ready ? "WAIT · EXACT\nGate → Type\n" + parent_progress : "WAIT · NO VERDICT\nType evidence\n" + parent_progress) : f_stats_direct_readout(rank_stats, is_buy_rank, rank_target)
                                value_color = stats_sample_policy == "Adaptive" and not exact_has_verdict ? #FFC107 : f_stats_direct_color(rank_stats, is_buy_rank, rank_target)

                                table.cell(dashboard, 0, row, label_text, text_color=dir_clr, text_size=txt_size_body)
                                table.cell(dashboard, 1, row, value_text, text_color=value_color, text_size=txt_size_body)
                                row += 1
                                display_count += 1

                        // 如果没有数据显示提示
                        if display_count == 0
                            table.cell(dashboard, 0, row, "No usable buckets", text_color=color.gray, text_size=txt_size_body)
                            table.cell(dashboard, 1, row, "Need effective n ≥ 5", text_color=color.gray, text_size=txt_size_body)

// ────────────────────────────────────────
// SMART ALERT
// ────────────────────────────────────────

// varip retains sent levels across realtime ticks. Compare bar_index instead of
// barstate.isnew: a close-only strategy may never execute on the opening tick.
// varip 保留同根已发等级；按 bar_index 重置，兼容只在收盘运行的策略报告。
varip int alert_state_bar = na
varip int buy_alert_level_sent = 0
varip int sell_alert_level_sent = 0

f_signal_level(_mtf, _div, _ext, _norm) =>
    _mtf ? 4 : _div ? 3 : _ext ? 2 : _norm ? 1 : 0

// JSON strings escape quotes, backslashes and every U+0000–U+001F control
// character. Pine does not treat \r or \b as control-character escapes, so use
// regex code points instead of unsupported string-literal escape sequences.
// JSON 转义双引号、反斜线及全部 ASCII 控制字符，避免特殊标的名破坏快照。
f_alert_json_string(string _value) =>
    _escaped = str.replace_all(_value, "\\", "\\\\")
    _escaped := str.replace_all(_escaped, "\"", "\\\"")
    _hex_digits = "0123456789abcdef"
    for _code = 0 to 31
        _high = int(_code / 16)
        _low = _code % 16
        _hex = str.substring(_hex_digits, _high, _high + 1) + str.substring(_hex_digits, _low, _low + 1)
        _control = str.match(_escaped, "\\x" + _hex)
        if str.length(_control) > 0
            _escaped := str.replace_all(_escaped, _control, "\\u00" + _hex)
    "\"" + _escaped + "\""

f_alert_json_number(float _value) =>
    na(_value) ? "null" : str.tostring(_value, "0.################")

f_alert_json_int(int _value) =>
    na(_value) ? "null" : str.tostring(_value)

f_alert_json_bool(bool _value) =>
    _value ? "true" : "false"

f_alert_event_id(bool _is_buy, int _level) =>
    syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time) + "|" + (_is_buy ? "BUY" : "SELL") + "|" + str.tostring(_level)

f_alert_evidence_source(string _mode, string _kind, string _direction, string _grade) =>
    _mode == "Signal Type" ? "Signal Type:" + _kind + " " + _direction :
     _mode == "Grade" ? "Grade:" + _direction + " [Score " + _grade + "]" :
     "Ranking:" + _kind + " " + _direction + " [Score " + _grade + "]"

// Snapshot the evidence selected at this decision, never reconstruct it later.
// Disabled filters use requested evidence because no production gate consulted a
// parent. This is an alert decision record, not an order or fill confirmation.
// 快照固定当时的实际证据来源；过滤关闭时保留请求桶，不借用父级结论。
// 这是信号决策记录，不代表已下单、成交或实现了所示止损止盈。
f_alert_snapshot_json(bool _is_buy, int _level, string _grade, SignalStats _resolved_stats, int _resolved_target, string _source) =>
    _is_mtf = _level == 4
    _is_div = _level == 3
    _is_ext = _level == 2
    _kind = f_signal_kind_name(f_signal_kind_index(_is_mtf, _is_div, _is_ext))
    _direction = _is_buy ? "BUY" : "SELL"
    _gate_active = enable_stats and enable_stats_filter
    _requested_stats = stats_mode == "Signal Type" ? f_get_signal_type_stats(_is_buy, _is_mtf, _is_div, _is_ext) : stats_mode == "Grade" ? f_get_grade_stats(_is_buy, _grade) : f_get_signal_stats(_is_buy, _is_mtf, _is_div, _is_ext, _grade)
    _requested_target = stats_mode == "Signal Type" ? f_get_signal_type_target(_is_buy, _is_mtf, _is_div, _is_ext) : stats_mode == "Grade" ? f_get_grade_target(_is_buy, _grade) : f_get_signal_target(_is_buy, _is_mtf, _is_div, _is_ext, _grade)
    _stats_used = _gate_active ? _resolved_stats : _requested_stats
    _target = _gate_active ? _resolved_target : _requested_target
    _uses_parent = _gate_active and _source == "Type fallback"
    _requested_source = f_alert_evidence_source(stats_mode, _kind, _direction, _grade)
    _resolved_source = _uses_parent ? f_alert_evidence_source("Signal Type", _kind, _direction, _grade) : _requested_source
    [_ready, _edge_mode, _payoff_active, _wr_pass, _payoff_pass, _quality_ok, _adjusted_wr, _payoff_edge] = f_stats_gate_paths(_stats_used, _is_buy, _target)
    _lifetime_n = _stats_used.get_lifetime_count()
    _effective_n = _stats_used.get_count()
    _has_estimate = enable_stats and _lifetime_n >= 5
    _readiness = not enable_stats ? "DISABLED" : _ready ? "READY" : _lifetime_n < _target ? "WAITING" : "STALE"
    _quality_verdict = not enable_stats ? "STATS_OFF" : not enable_stats_filter ? "FILTER_OFF" : not _ready ? "NO_VERDICT" : _quality_ok ? "PASS" : "BLOCK"
    _allowed = signal_data_ready and f_passes_stats_filter(_stats_used, _is_buy, _target)
    _baseline = array.get(baseline_stats, f_dir_bucket_index(_is_buy))
    _baseline_available = enable_stats and _baseline.get_lifetime_count() > 0
    _baseline_wr = _baseline_available ? f_stats_baseline_rate(_is_buy) : na
    _baseline_avg = _baseline_available ? f_stats_baseline_avg(_is_buy) : na
    _prior_wr = enable_stats ? f_stats_display_prior(_is_buy) : na
    _raw_wr = enable_stats and _lifetime_n > 0 ? _stats_used.get_winrate() : na
    _bucket_avg = enable_stats and _lifetime_n > 0 ? _stats_used.get_avg() : na
    _reported_wr = _has_estimate ? _adjusted_wr : na
    _reported_payoff = _has_estimate ? _payoff_edge : na
    _wr_edge = _has_estimate and _baseline_available ? _adjusted_wr - _baseline_wr : na
    _required_wr = enable_stats ? f_stats_required_winrate(_is_buy) : na
    _shrinkage_weight = enable_stats ? math.min(1.0, _effective_n / 20.0) : na
    _wr_pass_json = _has_estimate ? f_alert_json_bool(_wr_pass) : "null"
    _payoff_pass_json = _has_estimate ? f_alert_json_bool(_payoff_pass) : "null"
    _sl_price = _is_buy ? buy_sl_price : sell_sl_price
    _tp_price = _is_buy ? buy_tp_price : sell_tp_price

    _json = "{\"schema\":\"arsi.alert.v1\",\"message_kind\":\"signal_decision\""
    _json := _json + ",\"event_id\":" + f_alert_json_string(f_alert_event_id(_is_buy, _level))
    _json := _json + ",\"script_version\":" + f_alert_json_string(SCRIPT_VERSION)
    _json := _json + ",\"tickerid\":" + f_alert_json_string(syminfo.tickerid)
    _json := _json + ",\"timeframe\":" + f_alert_json_string(timeframe.period)
    _json := _json + ",\"bar_time\":" + f_alert_json_int(time) + ",\"bar_time_close\":" + f_alert_json_int(time_close)
    _json := _json + ",\"observed_time\":" + f_alert_json_int(timenow) + ",\"price\":" + f_alert_json_number(close)
    _json := _json + ",\"confirmed\":" + f_alert_json_bool(barstate.isconfirmed) + ",\"signal_data_ready\":" + f_alert_json_bool(signal_data_ready)
    _json := _json + ",\"direction\":" + f_alert_json_string(_direction) + ",\"level\":" + f_alert_json_int(_level)
    _json := _json + ",\"type\":" + f_alert_json_string(_kind) + ",\"grade\":" + f_alert_json_string(_grade)
    _json := _json + ",\"evidence\":{\"metric\":\"fixed_horizon_directional_return\",\"forward_bars\":" + f_alert_json_int(stats_forward_bars)
    _json := _json + ",\"requested_source\":" + f_alert_json_string(_requested_source) + ",\"resolved_source\":" + f_alert_json_string(_resolved_source)
    _json := _json + ",\"uses_parent\":" + f_alert_json_bool(_uses_parent)
    _json := _json + ",\"lifetime_n\":" + f_alert_json_int(_lifetime_n) + ",\"effective_n\":" + f_alert_json_number(_effective_n) + ",\"target\":" + f_alert_json_int(_target)
    _json := _json + ",\"readiness\":" + f_alert_json_string(_readiness) + ",\"quality_verdict\":" + f_alert_json_string(_quality_verdict)
    _json := _json + ",\"gate_active\":" + f_alert_json_bool(_gate_active) + ",\"allowed\":" + f_alert_json_bool(_allowed)
    _json := _json + ",\"sample_policy\":" + f_alert_json_string(stats_sample_policy) + ",\"unproven_policy\":" + f_alert_json_string(stats_unproven_mode)
    _json := _json + ",\"gate_mode\":" + f_alert_json_string(stats_gate_mode) + ",\"payoff_mode\":" + f_alert_json_string(stats_payoff_mode)
    _json := _json + ",\"shrinkage_weight\":" + f_alert_json_number(_shrinkage_weight)
    _json := _json + ",\"raw_wr_pct\":" + f_alert_json_number(_raw_wr) + ",\"prior_wr_pct\":" + f_alert_json_number(_prior_wr)
    _json := _json + ",\"adjusted_wr_pct\":" + f_alert_json_number(_reported_wr) + ",\"baseline_wr_pct\":" + f_alert_json_number(_baseline_wr)
    _json := _json + ",\"required_wr_pct\":" + f_alert_json_number(_required_wr) + ",\"wr_edge_pp\":" + f_alert_json_number(_wr_edge)
    _json := _json + ",\"wr_pass\":" + _wr_pass_json
    _json := _json + ",\"bucket_avg_pct\":" + f_alert_json_number(_bucket_avg) + ",\"baseline_avg_pct\":" + f_alert_json_number(_baseline_avg)
    _json := _json + ",\"payoff_edge_pct\":" + f_alert_json_number(_reported_payoff) + ",\"required_payoff_pct\":" + f_alert_json_number(stats_min_payoff_edge)
    _json := _json + ",\"payoff_active\":" + f_alert_json_bool(_payoff_active) + ",\"payoff_pass\":" + _payoff_pass_json + "}"
    _json := _json + ",\"risk\":{\"basis\":\"decision_price\",\"hints_only\":true,\"sl_price\":" + f_alert_json_number(_sl_price) + ",\"tp_price\":" + f_alert_json_number(_tp_price) + "}}"
    _json

if na(alert_state_bar) or alert_state_bar != bar_index
    alert_state_bar := bar_index
    buy_alert_level_sent := 0
    sell_alert_level_sent := 0

// TradingView only delivers alerts in realtime; avoid rebuilding audit JSON for history.
// 历史K线不投递警报，因此只在实时执行中生成警报快照。
if enable_smart_alert and barstate.isrealtime
    // 使用统计过滤后的信号（所有模式都过滤Alert）。
    // Simultaneous eligible directions produce no actionable alert, matching the
    // strategy harness. Intrabar alerts sent before a later conflict cannot be
    // recalled; confirmed-bar delivery is therefore the default.
    filtered_buy_normal = show_normal_signals and alert_buy_norm
    filtered_sell_normal = show_normal_signals and alert_sell_norm
    alert_has_buy = alert_buy_mtf or alert_buy_div or alert_buy_ext or filtered_buy_normal
    alert_has_sell = alert_sell_mtf or alert_sell_div or alert_sell_ext or filtered_sell_normal
    alert_conflict = alert_has_buy and alert_has_sell

    // Alert-specific icon 选择（基于 alert_* 布尔值，与 Dashboard 独立）
    string alert_buy_icon = switch
        alert_buy_mtf => "🌟MTF共振"
        alert_buy_div => "💎背离"
        alert_buy_ext => "🔥极端"
        filtered_buy_normal => "⬆️超卖"
        => ""
    string alert_sell_icon = switch
        alert_sell_mtf => "🌟MTF共振"
        alert_sell_div => "💎背离"
        alert_sell_ext => "❄️极端"
        filtered_sell_normal => "⬇️超买"
        => ""

    // 每个方向读取其当时实际选择的桶，JSON 与文字共用同一个 gate 结果。
    // Each direction snapshots its selected evidence; JSON and text share the gate.
    buy_alert_stats = alert_buy_mtf ? buy_mtf_stats : alert_buy_div ? buy_div_stats : alert_buy_ext ? buy_ext_stats : buy_norm_stats
    buy_alert_target = alert_buy_mtf ? buy_mtf_stats_target : alert_buy_div ? buy_div_stats_target : alert_buy_ext ? buy_ext_stats_target : buy_norm_stats_target
    buy_alert_source = alert_buy_mtf ? buy_mtf_stats_source : alert_buy_div ? buy_div_stats_source : alert_buy_ext ? buy_ext_stats_source : buy_norm_stats_source
    sell_alert_stats = alert_sell_mtf ? sell_mtf_stats : alert_sell_div ? sell_div_stats : alert_sell_ext ? sell_ext_stats : sell_norm_stats
    sell_alert_target = alert_sell_mtf ? sell_mtf_stats_target : alert_sell_div ? sell_div_stats_target : alert_sell_ext ? sell_ext_stats_target : sell_norm_stats_target
    sell_alert_source = alert_sell_mtf ? sell_mtf_stats_source : alert_sell_div ? sell_div_stats_source : alert_sell_ext ? sell_ext_stats_source : sell_norm_stats_source
    buy_alert_insufficient = f_stats_insufficient(buy_alert_stats, buy_alert_target)
    sell_alert_insufficient = f_stats_insufficient(sell_alert_stats, sell_alert_target)
    string buy_alert_filter_status = enable_stats_filter and enable_stats ? (buy_alert_insufficient ? " ⏳" : " ✓") : ""
    string sell_alert_filter_status = enable_stats_filter and enable_stats ? (sell_alert_insufficient ? " ⏳" : " ✓") : ""

    current_buy_level = f_signal_level(alert_buy_mtf, alert_buy_div, alert_buy_ext, filtered_buy_normal)
    should_alert_buy = alert_has_buy and not alert_conflict and current_buy_level > buy_alert_level_sent and (not alert_on_close or barstate.isconfirmed)

    if should_alert_buy
        msg = str.format("{0}: 🟢 BUY → {1} ", syminfo.ticker, alert_buy_icon)

        if confirmation_buy
            msg := msg + "✓确认 "
        if reversal_buy
            msg := msg + "↩反转 "
        if realtime_bullish_div
            msg := msg + "⚡实时背离 "

        zscore_pct = f_zscore_to_percentile(rsi_zscore)
        msg := msg + str.format("| RSI:{0,number,#.1} Z:{1,number,#.2}σ (≈P{2,number,#}) [Score {3}]{4}", rsi, rsi_zscore, zscore_pct, buy_quality_grade, buy_alert_filter_status)

        if include_risk_in_alerts
            msg := msg + str.format(" | SL:-{0,number,#.1}% TP:+{1,number,#.1}%", buy_sl_pct, buy_tp_pct)

        if alert_format == "JSON"
            msg := f_alert_snapshot_json(true, current_buy_level, buy_quality_grade, buy_alert_stats, buy_alert_target, buy_alert_source)
        alert(msg, alert.freq_all)
        buy_alert_level_sent := current_buy_level

    current_sell_level = f_signal_level(alert_sell_mtf, alert_sell_div, alert_sell_ext, filtered_sell_normal)
    should_alert_sell = alert_has_sell and not alert_conflict and current_sell_level > sell_alert_level_sent and (not alert_on_close or barstate.isconfirmed)

    if should_alert_sell
        msg = str.format("{0}: 🔴 SELL → {1} ", syminfo.ticker, alert_sell_icon)

        if confirmation_sell
            msg := msg + "✓确认 "
        if reversal_sell
            msg := msg + "↩反转 "
        if realtime_bearish_div
            msg := msg + "⚡实时背离 "

        zscore_pct = f_zscore_to_percentile(rsi_zscore)
        msg := msg + str.format("| RSI:{0,number,#.1} Z:{1,number,#.2}σ (≈P{2,number,#}) [Score {3}]{4}", rsi, rsi_zscore, zscore_pct, sell_quality_grade, sell_alert_filter_status)

        if include_risk_in_alerts
            msg := msg + str.format(" | SL:+{0,number,#.1}% TP:-{1,number,#.1}%", sell_sl_pct, sell_tp_pct)

        if alert_format == "JSON"
            msg := f_alert_snapshot_json(false, current_sell_level, sell_quality_grade, sell_alert_stats, sell_alert_target, sell_alert_source)
        alert(msg, alert.freq_all)
        sell_alert_level_sent := current_sell_level

// ────────────────────────────────────────
// STRATEGY REPORT EXECUTION
// ────────────────────────────────────────

var float harness_long_sl_price = na
var float harness_long_tp_price = na
var float harness_short_sl_price = na
var float harness_short_tp_price = na

// Orders use confirmed signal closes and fill at the next available open. A
// reversal needs only strategy.entry: it closes the old side automatically.
// Date/time liquidation takes precedence; a single branch issues market orders.
// 收盘确定动作、下一可用开盘成交；反手只发 strategy.entry，自动平掉原方向。
// 日期/持仓期限退出优先；互斥分支避免平仓单与反手单重复提交。
if barstate.isconfirmed
    if harness_action == "Evaluation End" or harness_action == "Time Exit"
        strategy.cancel("Long Exit")
        strategy.cancel("Short Exit")
        strategy.close(strategy.position_size > 0 ? "Long" : "Short", comment=harness_action, alert_message=f_harness_order_message(harness_action == "Evaluation End" ? "EVALUATION_END" : "TIME_EXIT", strategy.position_size > 0 ? "LONG" : "SHORT"))
    else if harness_action == "Long"
        strategy.cancel("Short Exit")
        strategy.entry("Long", strategy.long, comment=strategy.position_size < 0 ? "REVERSE LONG" : "ENTRY LONG", alert_message=f_harness_order_message(strategy.position_size < 0 ? "REVERSE_LONG" : "ENTRY_LONG", "LONG"))
        harness_long_sl_price := buy_sl_price
        harness_long_tp_price := buy_tp_price
        // Entry-bound bracket protects the fill bar; prices remain signal-close
        // snapshots, so opening gaps can change the actual risk/reward ratio.
        // 入场同时挂止损止盈，覆盖成交当根；价格仍是信号收盘快照，跳空会改变实际盈亏比。
        if harness_use_risk_exits and (not na(harness_long_sl_price) or not na(harness_long_tp_price))
            strategy.exit("Long Exit", from_entry="Long", stop=harness_long_sl_price, limit=harness_long_tp_price, comment="ATR EXIT LONG", alert_message=f_harness_order_message("ATR_EXIT", "LONG"))
    else if harness_action == "Short"
        strategy.cancel("Long Exit")
        strategy.entry("Short", strategy.short, comment=strategy.position_size > 0 ? "REVERSE SHORT" : "ENTRY SHORT", alert_message=f_harness_order_message(strategy.position_size > 0 ? "REVERSE_SHORT" : "ENTRY_SHORT", "SHORT"))
        harness_short_sl_price := sell_sl_price
        harness_short_tp_price := sell_tp_price
        if harness_use_risk_exits and (not na(harness_short_sl_price) or not na(harness_short_tp_price))
            strategy.exit("Short Exit", from_entry="Short", stop=harness_short_sl_price, limit=harness_short_tp_price, comment="ATR EXIT SHORT", alert_message=f_harness_order_message("ATR_EXIT", "SHORT"))
    else if harness_action == "Close Long"
        strategy.cancel("Long Exit")
        strategy.close("Long", comment=harness_raw_exit ? "RAW EXIT LONG" : "FILTERED EXIT LONG", alert_message=f_harness_order_message(harness_raw_exit ? "RAW_EXIT" : "FILTERED_EXIT", "LONG"))
    else if harness_action == "Close Short"
        strategy.cancel("Short Exit")
        strategy.close("Short", comment=harness_raw_exit ? "RAW EXIT SHORT" : "FILTERED EXIT SHORT", alert_message=f_harness_order_message(harness_raw_exit ? "RAW_EXIT" : "FILTERED_EXIT", "SHORT"))

// Refresh unchanged brackets only when no market action replaces them. Risk
// protection remains active outside the date/data/evidence entry conditions.
// 无市场动作替代时刷新原止损止盈；退出保护不受入场日期、数据、证据门槛限制。
if harness_use_risk_exits and harness_action == "Idle"
    if strategy.position_size > 0 and (not na(harness_long_sl_price) or not na(harness_long_tp_price))
        strategy.exit("Long Exit", from_entry="Long", stop=harness_long_sl_price, limit=harness_long_tp_price, comment="ATR EXIT LONG", alert_message=f_harness_order_message("ATR_EXIT", "LONG"))
    if strategy.position_size < 0 and (not na(harness_short_sl_price) or not na(harness_short_tp_price))
        strategy.exit("Short Exit", from_entry="Short", stop=harness_short_sl_price, limit=harness_short_tp_price, comment="ATR EXIT SHORT", alert_message=f_harness_order_message("ATR_EXIT", "SHORT"))

// The planner triggers time exit at the close of held bar N-1, giving exactly N
// open-to-open held bars with the declared calculation settings (0 disables it).
// 选择器在第 N-1 根持仓K线收盘提交时间退出，默认计算设置下持有 N 根开盘到开盘K线。
